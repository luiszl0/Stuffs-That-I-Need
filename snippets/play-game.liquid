{% doc %}
  Renders the pixel art arcade game shown on the Play collection page.

  Products used for rewards come from the given collection (available
  products only), falling back to the full catalog. Discount codes are
  merchant-configured; when blank, the game never claims a discount exists.

  @param {collection} collection - Collection whose products are shown as rewards
  @param {string} [code_small] - Shopify discount code unlocked at 30 points (2%)
  @param {string} [code_max] - Shopify discount code unlocked at 50 points (5%)

  @example
  {% render 'play-game', collection: collection, code_small: section.settings.play_code_small, code_max: section.settings.play_code_max %}
{% enddoc %}

{%- assign reward_source = collection.products | where: 'available' -%}
{%- if reward_source.size == 0 -%}
  {%- assign reward_source = collections['all'].products | where: 'available' -%}
{%- endif -%}

<section class="play-game" data-play-game aria-labelledby="play-game-title">
  <div class="play-game__head">
    <h2 id="play-game-title" class="play-game__title">{{ 'play_game.title' | t }}</h2>
    <p class="play-game__score" aria-live="off">
      <span>{{ 'play_game.score' | t }}</span>
      <strong data-score>0</strong>
    </p>
  </div>

  <div class="play-game__stage" data-stage>
    <canvas
      class="play-game__canvas"
      tabindex="0"
      role="img"
      aria-label="{{ 'play_game.canvas_label' | t | escape }}"
    ></canvas>

    <div class="play-game__overlay" data-panel="start">
      <div class="play-game__panel">
        <h3>{{ 'play_game.start.title' | t }}</h3>
        <p>{{ 'play_game.start.text' | t }}</p>
        <button class="button button--primary" type="button" data-action="start">{{ 'play_game.start.button' | t }}</button>
      </div>
    </div>

    <div class="play-game__overlay play-game__overlay--soft" data-panel="paused" hidden>
      <p class="play-game__pause">{{ 'play_game.paused' | t }}</p>
    </div>

    <div class="play-game__overlay" data-panel="over" hidden>
      <div class="play-game__panel">
        <h3>{{ 'play_game.over.title' | t }}</h3>
        <p data-over-text></p>
        <button class="button button--primary" type="button" data-action="restart">{{ 'play_game.restart' | t }}</button>
      </div>
    </div>

    <div class="play-game__overlay" data-panel="reward" hidden>
      <div class="play-game__panel">
        <p class="play-game__badge" data-reward-badge></p>
        <h3 data-reward-title></h3>
        <p data-reward-text></p>
        <div class="play-game__code" data-reward-code-wrap>
          <code data-reward-code></code>
          <button class="button button--secondary" type="button" data-action="copy">{{ 'play_game.copy' | t }}</button>
        </div>
        <p class="play-game__note" data-reward-note></p>
        <div class="play-game__actions">
          <button class="button button--primary" type="button" data-action="continue">{{ 'play_game.reward.continue_playing' | t }}</button>
          <button class="button button--primary" type="button" data-action="restart" hidden>{{ 'play_game.restart' | t }}</button>
          <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'play_game.reward.keep_shopping' | t }}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="play-game__discover" aria-live="polite" data-discover>
    <p class="play-game__hint" data-discover-hint>{{ 'play_game.discover_hint' | t }}</p>
    <a class="play-game__product" href="#" data-product hidden>
      <img alt="" width="64" height="64" data-product-image>
      <span class="play-game__product-text">
        <small>{{ 'play_game.product.label' | t }}</small>
        <strong data-product-name></strong>
      </span>
      <span class="play-game__product-cta">{{ 'play_game.product.view' | t }}</span>
    </a>
  </div>

  <script type="application/json" data-play-config>
    {
      "codes": { "small": {{ code_small | strip | json }}, "max": {{ code_max | strip | json }} },
      "products": [
        {%- for product in reward_source limit: 10 -%}
          {%- assign reward_image = product.featured_image | default: product.images.first -%}
          {
            "name": {{ product.title | json }},
            "url": {{ product.url | json }},
            "image": {% if reward_image != blank %}{{ reward_image | image_url: width: 160 | json }}{% else %}""{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "strings": {
        "scoreOver": {{ 'play_game.over.text' | t: score: '__SCORE__' | json }},
        "milestone": {{ 'play_game.reward.milestone_badge' | t | json }},
        "winBadge": {{ 'play_game.reward.win_badge' | t | json }},
        "smallTitle": {{ 'play_game.reward.small_title' | t | json }},
        "smallText": {{ 'play_game.reward.small_text' | t | json }},
        "winTitle": {{ 'play_game.reward.win_title' | t | json }},
        "winText": {{ 'play_game.reward.win_text' | t | json }},
        "noCodeTitle": {{ 'play_game.reward.no_code_title' | t | json }},
        "noCode": {{ 'play_game.reward.no_code' | t | json }},
        "codeNote": {{ 'play_game.reward.code_note' | t | json }},
        "copy": {{ 'play_game.copy' | t | json }},
        "copied": {{ 'play_game.copied' | t | json }}
      }
    }
  </script>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-play-game]');
    if (!root) return;

    var cfg = JSON.parse(root.querySelector('[data-play-config]').textContent);
    var t = cfg.strings;
    var canvas = root.querySelector('canvas');
    var ctx = canvas.getContext('2d');
    var stage = root.querySelector('[data-stage]');
    var scoreEl = root.querySelector('[data-score]');
    var panels = {};
    root.querySelectorAll('[data-panel]').forEach(function (el) {
      panels[el.getAttribute('data-panel')] = el;
    });

    var W = 300;
    var H = 210;
    canvas.width = W;
    canvas.height = H;
    ctx.imageSmoothingEnabled = false;

    var styles = getComputedStyle(root);
    function token(name, fallback) {
      return styles.getPropertyValue(name).trim() || fallback;
    }
    var COLORS = {
      sky: token('--brand-pale-blue', '#E1E5F8'),
      ink: token('--brand-charcoal', '#111111'),
      blue: token('--brand-cobalt', '#2448E8'),
      light: token('--brand-white', '#FFFDF8')
    };
    var PALETTE = { o: COLORS.ink, b: COLORS.blue, w: COLORS.light };

    var BIRD_TOP = ['...oooooo...', '..obbbbbbo..', '.obbbbbwwwo.', '.obbbbbwowwo'];
    var BIRD_FRAMES = [
      BIRD_TOP.concat(['obwwbbbbbooo', 'obwwwbbbbbo.', '.obwwbbbbo..', '..ooobbboo..', '....oooo....']),
      BIRD_TOP.concat(['obbbbbbbbooo', 'obbbbbbbbbo.', '.obwwwbbbo..', '..owwwwboo..', '....oooo....'])
    ];
    var SCALE = 2;
    var BIRD_W = 12 * SCALE;
    var BIRD_H = 9 * SCALE;
    var BIRD_X = 58;

    var PIPE_W = 30;
    var PIPE_GAP = 74;
    var PIPE_SPACING = 125;
    var CAP_H = 8;
    var CAP_EXTRA = 3;

    var state = 'idle';
    var score = 0;
    var shown = {};
    var pipes = [];
    var clouds = [];
    var birdY = H / 2;
    var targetY = H / 2;
    var frame = 0;
    var frameTimer = 0;
    var grace = 0;
    var lastTime = 0;
    var rafId = 0;
    var touchPlaying = false;
    var productIndex = 0;
    var copyTimer = 0;

    function show(name) {
      Object.keys(panels).forEach(function (key) {
        panels[key].hidden = key !== name;
      });
    }

    function setScore(value) {
      score = value;
      scoreEl.textContent = value;
    }

    function reset() {
      pipes = [];
      clouds = [
        { x: 40, y: 30, w: 26 },
        { x: 170, y: 60, w: 34 },
        { x: 260, y: 22, w: 22 }
      ];
      shown = {};
      productIndex = 0;
      birdY = H / 2;
      targetY = H / 2;
      setScore(0);
    }

    function spawnPipe() {
      var margin = 28;
      var center = margin + PIPE_GAP / 2 + Math.random() * (H - margin * 2 - PIPE_GAP);
      pipes.push({ x: W + 4, gapY: center, passed: false });
    }

    function speed() {
      return Math.min(70 + score * 1.6, 112);
    }

    function startRun() {
      reset();
      grace = 0.4;
      state = 'running';
      show(null);
      lastTime = 0;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(loop);
      canvas.focus({ preventScroll: true });
    }

    function pause() {
      if (state !== 'running') return;
      state = 'paused';
      show('paused');
    }

    function resume() {
      if (state !== 'paused') return;
      state = 'running';
      grace = 0.6;
      lastTime = 0;
      show(null);
    }

    function setTargetFromEvent(event) {
      var rect = canvas.getBoundingClientRect();
      if (!rect.height) return;
      var y = ((event.clientY - rect.top) / rect.height) * H;
      targetY = Math.max(0, Math.min(H, y));
    }

    function hits(pipe) {
      var bx1 = BIRD_X + 4;
      var bx2 = BIRD_X + BIRD_W - 4;
      var by1 = birdY + 3;
      var by2 = birdY + BIRD_H - 3;
      var px1 = pipe.x - CAP_EXTRA;
      var px2 = pipe.x + PIPE_W + CAP_EXTRA;
      if (bx2 < px1 || bx1 > px2) return false;
      return by1 < pipe.gapY - PIPE_GAP / 2 || by2 > pipe.gapY + PIPE_GAP / 2;
    }

    function update(dt) {
      frameTimer += dt;
      if (frameTimer > 0.12) {
        frameTimer = 0;
        frame = 1 - frame;
      }

      birdY += (targetY - BIRD_H / 2 - birdY) * Math.min(1, dt * 14);
      birdY = Math.max(2, Math.min(H - BIRD_H - 2, birdY));

      var v = speed();
      clouds.forEach(function (cloud) {
        cloud.x -= v * 0.25 * dt;
        if (cloud.x + cloud.w < 0) {
          cloud.x = W + 10;
          cloud.y = 14 + Math.random() * 70;
        }
      });

      var last = pipes[pipes.length - 1];
      if (!last || last.x < W - PIPE_SPACING) spawnPipe();

      for (var i = pipes.length - 1; i >= 0; i--) {
        var pipe = pipes[i];
        pipe.x -= v * dt;
        if (pipe.x + PIPE_W + CAP_EXTRA < 0) {
          pipes.splice(i, 1);
          continue;
        }
        if (grace <= 0 && hits(pipe)) {
          gameOver();
          return;
        }
        if (!pipe.passed && pipe.x + PIPE_W < BIRD_X) {
          pipe.passed = true;
          addPoint();
          if (state !== 'running') return;
        }
      }
      if (grace > 0) grace -= dt;
    }

    function addPoint() {
      setScore(score + 1);
      if (shown[score]) return;
      if (score === 30) {
        shown[score] = true;
        showReward('small');
      } else if (score >= 50) {
        shown[score] = true;
        showReward('max');
      } else if (score % 5 === 0) {
        shown[score] = true;
        showProduct();
      }
    }

    function showProduct() {
      if (!cfg.products.length) return;
      var product = cfg.products[productIndex % cfg.products.length];
      productIndex++;
      var link = root.querySelector('[data-product]');
      var img = root.querySelector('[data-product-image]');
      link.href = product.url;
      root.querySelector('[data-product-name]').textContent = product.name;
      if (product.image) {
        img.src = product.image;
        img.alt = product.name;
        img.hidden = false;
      } else {
        img.hidden = true;
      }
      root.querySelector('[data-discover-hint]').hidden = true;
      link.hidden = false;
      link.classList.remove('is-new');
      void link.offsetWidth;
      link.classList.add('is-new');
    }

    function showReward(kind) {
      var isMax = kind === 'max';
      var code = (isMax ? cfg.codes.max : cfg.codes.small) || '';
      var panel = panels.reward;
      state = isMax ? 'won' : 'reward';
      panel.classList.toggle('play-game__overlay--win', isMax);
      panel.querySelector('[data-reward-badge]').textContent = isMax ? t.winBadge : t.milestone;
      panel.querySelector('[data-reward-title]').textContent = !code ? t.noCodeTitle : isMax ? t.winTitle : t.smallTitle;
      panel.querySelector('[data-reward-text]').textContent = code ? (isMax ? t.winText : t.smallText) : t.noCode;
      panel.querySelector('[data-reward-code-wrap]').hidden = !code;
      panel.querySelector('[data-reward-note]').hidden = !code;
      panel.querySelector('[data-reward-note]').textContent = t.codeNote;
      panel.querySelector('[data-reward-code]').textContent = code;
      var copyBtn = panel.querySelector('[data-action="copy"]');
      copyBtn.textContent = t.copy;
      panel.querySelector('[data-action="continue"]').hidden = isMax;
      panel.querySelector('[data-action="restart"]').hidden = !isMax;
      show('reward');
      draw();
    }

    function gameOver() {
      state = 'over';
      root.querySelector('[data-over-text]').textContent = t.scoreOver.replace('__SCORE__', score);
      show('over');
      draw();
    }

    function fallbackCopy(text) {
      var area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      var ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (error) {
        ok = false;
      }
      document.body.removeChild(area);
      return ok;
    }

    function copyCode(button) {
      var text = panels.reward.querySelector('[data-reward-code]').textContent;
      if (!text) return;
      function done(ok) {
        if (!ok) return;
        button.textContent = t.copied;
        clearTimeout(copyTimer);
        copyTimer = setTimeout(function () {
          button.textContent = t.copy;
        }, 2200);
      }
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(
          function () {
            done(true);
          },
          function () {
            done(fallbackCopy(text));
          }
        );
      } else {
        done(fallbackCopy(text));
      }
    }

    function rect(x, y, w, h, color) {
      ctx.fillStyle = color;
      ctx.fillRect(Math.round(x), Math.round(y), w, h);
    }

    function drawCloud(cloud) {
      var x = Math.round(cloud.x);
      var y = Math.round(cloud.y);
      rect(x, y + 5, cloud.w, 6, COLORS.light);
      rect(x + 5, y, cloud.w - 12, 6, COLORS.light);
    }

    function drawPipeSegment(x, y, w, h) {
      if (h <= 0) return;
      rect(x, y, w, h, COLORS.ink);
      rect(x + 2, y, w - 4, h, COLORS.blue);
      rect(x + 5, y, 3, h, COLORS.light);
    }

    function drawPipe(pipe) {
      var top = pipe.gapY - PIPE_GAP / 2;
      var bottom = pipe.gapY + PIPE_GAP / 2;
      var x = Math.round(pipe.x);
      drawPipeSegment(x, 0, PIPE_W, top - CAP_H);
      drawPipeSegment(x - CAP_EXTRA, top - CAP_H, PIPE_W + CAP_EXTRA * 2, CAP_H);
      drawPipeSegment(x, bottom + CAP_H, PIPE_W, H - bottom - CAP_H);
      drawPipeSegment(x - CAP_EXTRA, bottom, PIPE_W + CAP_EXTRA * 2, CAP_H);
    }

    function drawBird() {
      var sprite = BIRD_FRAMES[frame];
      var x = BIRD_X;
      var y = Math.round(birdY);
      for (var row = 0; row < sprite.length; row++) {
        for (var col = 0; col < sprite[row].length; col++) {
          var color = PALETTE[sprite[row][col]];
          if (color) rect(x + col * SCALE, y + row * SCALE, SCALE, SCALE, color);
        }
      }
    }

    function draw() {
      rect(0, 0, W, H, COLORS.sky);
      clouds.forEach(drawCloud);
      pipes.forEach(drawPipe);
      drawBird();
    }

    function loop(time) {
      if (state === 'running') {
        var dt = lastTime ? Math.min((time - lastTime) / 1000, 0.05) : 0;
        lastTime = time;
        update(dt);
      }
      draw();
      if (state === 'running' || state === 'paused') {
        rafId = requestAnimationFrame(loop);
      }
    }

    stage.addEventListener('pointermove', function (event) {
      if (state === 'running') setTargetFromEvent(event);
    });

    stage.addEventListener('pointerdown', function (event) {
      if (event.pointerType === 'mouse') return;
      if (state === 'paused') resume();
      if (state === 'running') {
        touchPlaying = true;
        setTargetFromEvent(event);
      }
    });

    function onTouchEnd(event) {
      if (event.pointerType === 'mouse' || !touchPlaying) return;
      touchPlaying = false;
      pause();
    }
    stage.addEventListener('pointerup', onTouchEnd);
    stage.addEventListener('pointercancel', onTouchEnd);

    stage.addEventListener('pointerenter', function (event) {
      if (event.pointerType === 'mouse') {
        setTargetFromEvent(event);
        resume();
      }
    });

    stage.addEventListener('pointerleave', function (event) {
      if (event.pointerType === 'mouse') pause();
    });

    canvas.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
      event.preventDefault();
      if (state === 'paused') resume();
      var step = event.key === 'ArrowUp' ? -16 : 16;
      targetY = Math.max(0, Math.min(H, targetY + step));
    });

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) pause();
    });

    root.addEventListener('click', function (event) {
      var button = event.target.closest('[data-action]');
      if (!button) return;
      var action = button.getAttribute('data-action');
      if (action === 'start' || action === 'restart') {
        startRun();
      } else if (action === 'continue') {
        state = 'running';
        grace = 1;
        lastTime = 0;
        show(null);
        rafId = requestAnimationFrame(loop);
      } else if (action === 'copy') {
        copyCode(button);
      }
    });

    reset();
    show('start');
    draw();
  })();
</script>

{% stylesheet %}
  .play-game {
    max-width: 46rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
  }
  .play-game__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .play-game__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }
  .play-game__score {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    color: var(--brand-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .play-game__score strong {
    min-width: 2ch;
    color: var(--brand-cobalt);
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0;
    line-height: 1;
    text-align: right;
  }
  .play-game__stage {
    position: relative;
    aspect-ratio: 10 / 7;
    overflow: hidden;
    border: 1px solid var(--brand-charcoal);
    background: var(--brand-pale-blue);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    overscroll-behavior: contain;
  }
  .play-game__canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    outline-offset: -4px;
  }
  .play-game__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(255, 253, 248, 0.9);
    text-align: center;
  }
  .play-game__overlay[hidden],
  .play-game__product[hidden],
  .play-game__hint[hidden],
  .play-game__panel [hidden] {
    display: none;
  }
  .play-game__overlay--soft {
    background: rgba(255, 253, 248, 0.55);
    pointer-events: none;
  }
  .play-game__overlay--win {
    background: rgba(225, 229, 248, 0.96);
  }
  .play-game__panel {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 24rem;
  }
  .play-game__panel h3 {
    margin: 0;
    font-size: clamp(1.3rem, 4vw, 2rem);
    line-height: 1.1;
  }
  .play-game__panel p {
    margin: 0;
    color: var(--brand-muted);
    line-height: 1.5;
  }
  .play-game__panel .play-game__badge {
    color: var(--brand-cobalt);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .play-game__panel .play-game__note {
    font-size: 0.8rem;
  }
  .play-game__pause {
    margin: 0;
    padding: 0.6rem 1rem;
    background: var(--brand-charcoal);
    color: var(--brand-white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .play-game__code {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 0.5rem;
  }
  .play-game__code code {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1rem;
    border: 1px dashed var(--brand-cobalt);
    background: var(--brand-white);
    color: var(--brand-charcoal);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    user-select: all;
    -webkit-user-select: all;
  }
  .play-game__code .button {
    min-height: 0;
    padding: 0.6rem 1rem;
  }
  .play-game__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .play-game__discover {
    min-height: 5.25rem;
    margin-top: 0.75rem;
  }
  .play-game__hint {
    margin: 0;
    padding: 1.4rem 0;
    color: var(--brand-muted);
    font-size: 0.9rem;
    text-align: center;
  }
  .play-game__product {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border: 1px solid var(--brand-charcoal);
    background: var(--brand-white);
    color: var(--brand-charcoal);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .play-game__product:hover,
  .play-game__product:focus-visible {
    background: var(--brand-pale-blue);
  }
  .play-game__product.is-new {
    animation: play-game-pop 0.35s ease-out;
  }
  .play-game__product img {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    background: var(--brand-pale-blue);
  }
  .play-game__product-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .play-game__product-text small {
    color: var(--brand-cobalt);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .play-game__product-text strong {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .play-game__product-cta {
    color: var(--brand-cobalt);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @keyframes play-game-pop {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 599px) {
    .play-game__panel {
      gap: 0.5rem;
    }
    .play-game__panel p {
      font-size: 0.85rem;
      line-height: 1.4;
    }
    .play-game__panel .button {
      min-height: 2.6rem;
      padding: 0.55rem 1rem;
    }
    .play-game__product {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
    .play-game__product img {
      width: 3.5rem;
      height: 3.5rem;
    }
    .play-game__product-cta {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .play-game__product.is-new {
      animation: none;
    }
  }
{% endstylesheet %}
