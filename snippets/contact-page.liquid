{% doc %}
  Renders the full contact page layout: heading, introduction, contact email
  and a native Shopify contact form with accessible validation and feedback.

  @param {page} page - The page being rendered, used for optional extra content

  @example
  {% render 'contact-page', page: page %}
{% enddoc %}

{%- assign contact_email = 'stuffthatineedofficial@gmail.com' -%}

<div class="contact page-width">
  <header class="contact__header">
    <p class="contact__eyebrow">{{ 'contact.eyebrow' | t }}</p>
    <h1>{{ 'contact.title' | t }}</h1>
    <p class="contact__intro">{{ 'contact.intro' | t }}</p>
  </header>

  <div class="contact__layout">
    <aside class="contact__info">
      <div class="contact__card">
        <span class="contact__icon">{% render 'icon', name: 'mail', size: 22 %}</span>
        <h2>{{ 'contact.email_title' | t }}</h2>
        <a class="contact__email" href="mailto:{{ contact_email }}">{{ contact_email }}</a>
        <p>{{ 'contact.email_hint' | t }}</p>
      </div>

      {% if page.content != blank %}
        <div class="contact__extra">{{ page.content }}</div>
      {% endif %}

      {% if shop.refund_policy or shop.shipping_policy %}
        <ul class="contact__links">
          {% if shop.shipping_policy %}
            <li><a href="{{ shop.shipping_policy.url }}">{{ 'policies.shipping' | t }}</a></li>
          {% endif %}
          {% if shop.refund_policy %}
            <li><a href="{{ shop.refund_policy.url }}">{{ 'policies.returns' | t }}</a></li>
          {% endif %}
        </ul>
      {% endif %}
    </aside>

    <div class="contact__form-wrap">
      {%- form 'contact', id: 'contact-form', class: 'contact-form', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-form__success" role="status" tabindex="-1" data-contact-feedback>
            <strong>{{ 'contact.success_title' | t }}</strong>
            <span>{{ 'contact.success_text' | t }}</span>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="contact-form__errors" role="alert" tabindex="-1" data-contact-feedback>
            <strong>{{ 'contact.error_title' | t }}</strong>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#contact-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-name">{{ 'contact.form.name' | t }} <span class="contact-form__req" aria-hidden="true">*</span></label>
            <input
              id="contact-name"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{{ form.name | escape }}"
              required
              aria-describedby="contact-name-error"
            >
            <p class="contact-form__error" id="contact-name-error" hidden></p>
          </div>

          <div class="contact-form__field">
            <label for="contact-email">{{ 'contact.form.email' | t }} <span class="contact-form__req" aria-hidden="true">*</span></label>
            <input
              id="contact-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              value="{{ form.email | escape }}"
              required
              aria-describedby="contact-email-error"
            >
            <p class="contact-form__error" id="contact-email-error" hidden></p>
          </div>
        </div>

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-order">
              {{ 'contact.form.order' | t }}
              <span class="contact-form__optional">{{ 'contact.form.optional' | t }}</span>
            </label>
            <input
              id="contact-order"
              type="text"
              name="contact[Número do pedido]"
              autocomplete="off"
              inputmode="text"
              value="{{ form['Número do pedido'] | escape }}"
              placeholder="{{ 'contact.form.order_placeholder' | t }}"
            >
          </div>

          <div class="contact-form__field">
            <label for="contact-subject">{{ 'contact.form.subject' | t }} <span class="contact-form__req" aria-hidden="true">*</span></label>
            <input
              id="contact-subject"
              type="text"
              name="contact[Assunto]"
              value="{{ form['Assunto'] | escape }}"
              required
              aria-describedby="contact-subject-error"
            >
            <p class="contact-form__error" id="contact-subject-error" hidden></p>
          </div>
        </div>

        <div class="contact-form__field">
          <label for="contact-body">{{ 'contact.form.message' | t }} <span class="contact-form__req" aria-hidden="true">*</span></label>
          <textarea
            id="contact-body"
            name="contact[body]"
            rows="7"
            required
            aria-describedby="contact-body-error"
          >{{ form.body | escape }}</textarea>
          <p class="contact-form__error" id="contact-body-error" hidden></p>
        </div>

        <div class="contact-form__footer">
          <button class="button button--primary contact-form__submit" type="submit">{{ 'contact.form.submit' | t }}</button>
          <p class="contact-form__note">{{ 'contact.form.required_note' | t }}</p>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('contact-form');
    if (!form) return;

    var messages = {
      required: {{ 'contact.validation.required' | t | json }},
      email: {{ 'contact.validation.email' | t | json }}
    };

    var feedback = form.querySelector('[data-contact-feedback]');
    if (feedback) feedback.focus();

    function validate(field) {
      var error = document.getElementById(field.id + '-error');
      if (!error) return true;
      var message = '';
      if (field.validity.valueMissing || (field.required && !field.value.trim())) {
        message = messages.required;
      } else if (field.validity.typeMismatch) {
        message = messages.email;
      }
      error.textContent = message;
      error.hidden = !message;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      return !message;
    }

    var fields = form.querySelectorAll('input[required], textarea[required]');

    fields.forEach(function (field) {
      field.addEventListener('blur', function () { validate(field); });
      field.addEventListener('input', function () {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    });

    form.addEventListener('submit', function (event) {
      var firstInvalid = null;
      fields.forEach(function (field) {
        if (!validate(field) && !firstInvalid) firstInvalid = field;
      });
      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
        return;
      }
      var button = form.querySelector('.contact-form__submit');
      if (button) button.disabled = true;
    });
  });
</script>

{% stylesheet %}
  .contact {
    padding-block: var(--section-space);
  }
  .contact__header {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .contact__eyebrow {
    margin: 0;
    color: var(--brand-cobalt);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .contact__header h1 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.08em;
  }
  .contact__intro {
    margin: 0;
    color: var(--brand-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .contact__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--brand-charcoal);
  }
  .contact__info {
    display: grid;
    gap: 1.5rem;
  }
  .contact__card {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--brand-pale-blue);
  }
  .contact__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    background: var(--brand-white);
    color: var(--brand-cobalt);
  }
  .contact__card h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
  }
  .contact__email {
    color: var(--brand-cobalt);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact__card p {
    margin: 0;
    color: var(--brand-muted);
    line-height: 1.6;
  }
  .contact__extra {
    color: var(--brand-muted);
    line-height: 1.7;
  }
  .contact__links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 1rem 0 0;
    list-style: none;
    border-top: 1px solid var(--brand-border);
  }
  .contact__links a {
    color: var(--brand-cobalt);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-form {
    display: grid;
    gap: 1.25rem;
  }
  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .contact-form__field {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .contact-form__field label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .contact-form__req {
    color: var(--brand-cobalt);
  }
  .contact-form__optional {
    margin-left: 0.4rem;
    color: var(--brand-muted);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .contact-form input,
  .contact-form textarea {
    width: 100%;
    min-height: 3.2rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--brand-border);
    border-radius: 0;
    background: var(--brand-white);
    color: var(--brand-charcoal);
    font: inherit;
    transition: border-color 0.2s ease;
  }
  .contact-form textarea {
    resize: vertical;
    min-height: 9rem;
  }
  .contact-form input:hover,
  .contact-form textarea:hover {
    border-color: var(--brand-charcoal);
  }
  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 2px;
    border-color: var(--brand-cobalt);
  }
  .contact-form [aria-invalid='true'] {
    border-color: #b3261e;
  }
  .contact-form__error {
    margin: 0;
    color: #b3261e;
    font-size: 0.85rem;
  }
  .contact-form__error[hidden] {
    display: none;
  }
  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .contact-form__submit {
    min-width: 14rem;
    border: 1px solid var(--brand-cobalt);
    background: var(--brand-cobalt);
    color: var(--brand-white);
    cursor: pointer;
  }
  .contact-form__submit:hover:not(:disabled) {
    border-color: var(--brand-charcoal);
    background: var(--brand-charcoal);
  }
  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .contact-form__note {
    margin: 0;
    color: var(--brand-muted);
    font-size: 0.85rem;
  }
  .contact-form__success,
  .contact-form__errors {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--brand-cobalt);
    background: var(--brand-pale-blue);
  }
  .contact-form__errors {
    border-left-color: #b3261e;
    background: #fbeceb;
  }
  .contact-form__errors ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .contact-form__errors a {
    text-decoration: underline;
  }
  .contact-form__success:focus,
  .contact-form__errors:focus {
    outline: 2px solid var(--brand-charcoal);
  }
  @media (max-width: 820px) {
    .contact__layout {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
    .contact-form__submit {
      width: 100%;
    }
  }
{% endstylesheet %}
