{% doc %}
  Renders a small inline stroke icon that inherits the current text color.

  @param {string} name - One of: check, mail, truck, return, lock, card, star, box, ruler, play, plus, minus, arrow-right
  @param {number} [size] - Width and height in pixels. Defaults to 24.

  @example
  {% render 'icon', name: 'truck' %}
  {% render 'icon', name: 'check', size: 18 %}
{% enddoc %}

{%- assign icon_size = size | default: 24 -%}
<svg
  class="icon icon--{{ name }}"
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14"/><path d="M3 7l9 6 9-6"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'return' -%}
      <path d="M4 9h11a5 5 0 010 10H8"/><path d="M8 5L4 9l4 4"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="9"/><path d="M8 11V8a4 4 0 018 0v3"/>
    {%- when 'card' -%}
      <rect x="3" y="6" width="18" height="12"/><path d="M3 10h18M7 15h3"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z"/>
    {%- when 'box' -%}
      <path d="M12 3l8 4v10l-8 4-8-4V7zM4 7l8 4 8-4M12 11v10"/>
    {%- when 'ruler' -%}
      <path d="M3 15L15 3l6 6L9 21zM8 10l2 2M11 7l2 2M5 13l2 2"/>
    {%- when 'play' -%}
      <circle cx="12" cy="12" r="9"/><path d="M10 8.5l5 3.5-5 3.5z"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16M14 6l6 6-6 6"/>
  {%- endcase -%}
</svg>

{% stylesheet %}
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }
  .icon--star {
    fill: currentColor;
  }
{% endstylesheet %}
