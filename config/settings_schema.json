[
  {
    "name": "theme_info",
    "theme_name": "Stuff That I Need",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Identidade visual",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Ícone da aba do navegador"
      }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      {
        "type": "header",
        "content": "Fontes"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Fonte principal"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Largura da página",
        "options": [
          {
            "value": "90rem",
            "label": "Estreita"
          },
          {
            "value": "110rem",
            "label": "Ampla"
          }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Margem da página",
        "default": 32
      }
    ]
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F2EFE7",
        "label": "Plano de fundo"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#242424",
        "label": "Texto"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Arredondamento dos campos",
        "default": 4
      }
    ]
  }
]
