{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page-width page-content">
  <h1 class="page-content__title">{{ page.title }}</h1>
  <div class="page-content__body">{{ page.content }}</div>

  {% if page.handle == 'contato' or page.handle == 'contact' %}
    {% form 'contact', class: 'contact-form' %}
      {% if form.posted_successfully? %}
        <p class="contact-form__success" role="status">Sua mensagem foi enviada. Obrigado pelo contato!</p>
      {% endif %}

      {% if form.errors %}
        <div class="contact-form__errors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <label for="ContactName">Nome</label>
      <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}">

      <label for="ContactEmail">E-mail</label>
      <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required>

      <label for="ContactMessage">Mensagem</label>
      <textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea>

      <button class="button button--primary" type="submit">Enviar mensagem</button>
    {% endform %}
  {% endif %}
</div>

{% stylesheet %}
  .page-content {
    padding-block: var(--section-space);
  }

  .page-content__title {
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  .page-content__body {
    max-width: 48rem;
  }

  .contact-form {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 40rem);
    margin-top: 2rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem;
    border: 1px solid var(--brand-border);
    border-radius: 0;
    background: var(--brand-white);
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .contact-form__success {
    color: var(--brand-cobalt);
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Conteúdo da página",
  "settings": []
}
{% endschema %}
