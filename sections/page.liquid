{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{% if page.handle == 'contato' or page.handle == 'contact' %}
  {% render 'contact-page', page: page %}
{% else %}
  <div class="page-width page-content">
    <h1 class="page-content__title">{{ page.title }}</h1>
    <div class="page-content__body">{{ page.content }}</div>
  </div>
{% endif %}

{% stylesheet %}
  .page-content {
    padding-block: var(--section-space);
  }

  .page-content__title {
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  .page-content__body {
    max-width: 48rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Conteúdo da página",
  "settings": []
}
{% endschema %}
