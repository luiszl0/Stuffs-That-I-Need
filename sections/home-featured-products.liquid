<section class="home-featured-products">
  <div class="page-width">
    {% assign featured_collection = section.settings.collection %}
    {% if featured_collection == blank %}
      {% assign featured_collection = collections.all %}
    {% endif %}

    <div class="section-heading">
      <div class="section-heading__copy">
        {% assign section_title = section.settings.heading %}
        {% if section_title == blank %}
          {% assign section_title = 'home.products.title' | t %}
        {% endif %}
        <p class="section-heading__eyebrow">{{ 'home.products.kicker' | t }}</p>
        <h2>{{ section_title }}</h2>

        {% assign section_subtitle = section.settings.subheading %}
        {% if section_subtitle == blank %}
          {% assign section_subtitle = 'home.products.subtitle' | t %}
        {% endif %}
        <p>{{ section_subtitle }}</p>
      </div>
      <a class="section-heading__link" href="{{ routes.all_products_collection_url }}">
        {{ 'home.products.view_all' | t }}
      </a>
    </div>

    {% if featured_collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% assign product_image = product.featured_image | default: product.images.first %}
          <article class="product-card">
            <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product_image %}
                {{ product_image | image_url: width: 800 | image_tag:
                  class: 'product-card__image',
                  alt: product_image.alt | default: product.title,
                  widths: '240, 360, 520, 800',
                  sizes: '(min-width: 1200px) 18vw, (min-width: 821px) 20vw, (min-width: 561px) 45vw, 46vw',
                  loading: 'lazy'
                }}
              {% else %}
                <div class="product-card__placeholder">{{ 'home.products.empty_state' | t }}</div>
              {% endif %}
            </a>

            <div class="product-card__body">
              <div class="product-card__meta">
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__badge">{{ 'home.products.promo' | t }}</span>
                {% endif %}
              </div>

              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>

              {% unless product.available %}
                <span class="product-card__sold-out">{{ 'products.sold_out' | t }}</span>
              {% endunless %}

              <div class="product-card__pricing">
                <span class="product-card__price">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__compare-price">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="product-empty">
        <h3>{{ 'home.products.empty_title' | t }}</h3>
        <p>{{ 'home.products.empty_text' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-featured-products {
    padding-block: var(--section-space);
    background: var(--brand-white);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .section-heading__copy {
    max-width: 52rem;
  }

  .section-heading__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-cobalt);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .section-heading h2 {
    max-width: 15ch;
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    letter-spacing: -0.085em;
    line-height: 0.9;
    margin-bottom: 0.45rem;
  }

  .section-heading p:last-child {
    color: var(--brand-muted);
    font-size: 0.92rem;
  }

  .section-heading__link {
    flex: 0 0 auto;
    margin-bottom: 0.2rem;
    font-size: 0.78rem;
    font-weight: 700;
    border-bottom: 1px solid var(--brand-cobalt);
    padding-bottom: 0.3rem;
    color: var(--brand-cobalt);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.9rem, 2vw, 1.75rem);
  }

  .product-card {
    min-width: 0;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--brand-border);
    border-radius: 0;
    background: transparent;
    transition: transform 0.25s ease;
  }

  .product-card:hover,
  .product-card:focus-within {
    transform: translateY(-4px);
  }

  .product-card__media {
    display: block;
    aspect-ratio: 1;
    border-radius: 0;
    overflow: hidden;
    background: var(--brand-canvas);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image,
  .product-card:focus-within .product-card__image {
    transform: scale(1.04);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--brand-canvas), var(--brand-pale-blue));
    font-weight: 600;
    color: var(--brand-muted);
  }

  .product-card__body {
    padding: 0.85rem 0.1rem 1rem;
  }

  .product-card__meta {
    min-height: 1.2rem;
  }

  .product-card__badge {
    display: inline-flex;
    border-radius: 0;
    background: var(--brand-cobalt);
    color: var(--brand-white);
    padding: 0.25rem 0.5rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card__sold-out {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 0.4rem;
    padding: 0.2rem 0.45rem;
    border-radius: 0;
    background: var(--brand-border);
    color: var(--brand-muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-card h3 {
    font-size: clamp(0.78rem, 1.05vw, 0.92rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    min-height: 2.7em;
    margin: 0.15rem 0 0.4rem;
  }

  .product-card__pricing {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .product-card__price {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .product-card__compare-price {
    font-size: 0.86rem;
    color: var(--brand-muted);
    text-decoration: line-through;
  }

  .product-empty {
    border: 0;
    border-radius: 0;
    padding: clamp(2.5rem, 7vw, 5.5rem) 1.25rem;
    text-align: center;
    background: var(--brand-canvas);
  }

  .product-empty h3 {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 820px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .section-heading {
      align-items: start;
      gap: 0.75rem;
    }

    .section-heading__link {
      font-size: 0.7rem;
      margin-top: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produtos em destaque",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Produtos exibidos",
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Pequenas coisas. Grandes vontades."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Os achadinhos que merecem um lugar na sua rotina."
    }
  ],
  "presets": [
    {
      "name": "Produtos em destaque",
      "category": "Página inicial"
    }
  ]
}
{% endschema %}
