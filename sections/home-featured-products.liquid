<section class="home-featured-products">
  <div class="page-width">
    {% assign featured_collection = section.settings.collection %}
    {% if featured_collection == blank %}
      {% assign featured_collection = collections.all %}
    {% endif %}

    <div class="section-heading">
      <div class="section-heading__copy">
        {% assign section_title = section.settings.heading %}
        {% if section_title == blank %}
          {% assign section_title = 'home.products.title' | t %}
        {% endif %}
        <p class="section-heading__eyebrow">{{ 'home.products.kicker' | t }}</p>
        <h2>{{ section_title }}</h2>

        {% assign section_subtitle = section.settings.subheading %}
        {% if section_subtitle == blank %}
          {% assign section_subtitle = 'home.products.subtitle' | t %}
        {% endif %}
        <p>{{ section_subtitle }}</p>
      </div>
      <a class="section-heading__link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">
        {{ 'home.products.view_all' | t }}
      </a>
    </div>

    {% if featured_collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <article class="product-card">
            <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 800 | image_tag:
                  class: 'product-card__image',
                  alt: product.featured_image.alt | default: product.title,
                  widths: '240, 360, 520, 800',
                  sizes: '(min-width: 1200px) 18vw, (min-width: 821px) 20vw, (min-width: 561px) 45vw, 46vw'
                }}
              {% else %}
                <div class="product-card__placeholder">{{ 'home.products.empty_state' | t }}</div>
              {% endif %}
            </a>

            <div class="product-card__body">
              <div class="product-card__meta">
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__badge">{{ 'home.products.promo' | t }}</span>
                {% endif %}
              </div>

              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>

              <div class="product-card__pricing">
                <span class="product-card__price">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__compare-price">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="product-empty">
        <h3>{{ 'home.products.empty_title' | t }}</h3>
        <p>{{ 'home.products.empty_text' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-featured-products {
    padding: clamp(2.75rem, 4vw, 3.5rem) 0 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .section-heading__copy {
    max-width: 52rem;
  }

  .section-heading__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-muted);
    margin-bottom: 0.75rem;
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    letter-spacing: -0.06em;
    line-height: 0.96;
    margin-bottom: 0.45rem;
  }

  .section-heading p:last-child {
    color: var(--brand-muted);
    font-size: 0.92rem;
  }

  .section-heading__link {
    flex: 0 0 auto;
    margin-bottom: 0.2rem;
    font-size: 0.78rem;
    font-weight: 700;
    border-bottom: 1px solid var(--brand-border);
    padding-bottom: 0.2rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .product-card {
    min-width: 0;
    overflow: hidden;
    padding: 0.45rem;
    border: 1px solid var(--brand-border);
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.48);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover,
  .product-card:focus-within {
    border-color: #c8c1b4;
    box-shadow: 0 0.5rem 1.25rem var(--brand-shadow);
    transform: translateY(-2px);
  }

  .product-card__media {
    display: block;
    aspect-ratio: 1;
    border-radius: 0.55rem;
    overflow: hidden;
    background: #efece6;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image,
  .product-card:focus-within .product-card__image {
    transform: scale(1.04);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #f3f0e8, #efeefb);
    font-weight: 600;
    color: var(--brand-muted);
  }

  .product-card__body {
    padding: 0.5rem 0.15rem 0.25rem;
  }

  .product-card__meta {
    min-height: 1.2rem;
  }

  .product-card__badge {
    display: inline-flex;
    border-radius: 999px;
    background: var(--brand-lime);
    color: var(--brand-charcoal);
    padding: 0.25rem 0.5rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card h3 {
    font-size: clamp(0.78rem, 1.05vw, 0.92rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    min-height: 2.7em;
    margin: 0.15rem 0 0.4rem;
  }

  .product-card__pricing {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .product-card__price {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .product-card__compare-price {
    font-size: 0.86rem;
    color: var(--brand-muted);
    text-decoration: line-through;
  }

  .product-empty {
    border: 1px dashed var(--brand-border);
    border-radius: 1.5rem;
    padding: 3rem 1.25rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.4);
  }

  .product-empty h3 {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 820px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .section-heading {
      align-items: start;
      gap: 0.75rem;
    }

    .section-heading__link {
      font-size: 0.7rem;
      margin-top: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 5
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pequenas coisas. Grandes vontades."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Os achadinhos que merecem um lugar na sua rotina."
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
