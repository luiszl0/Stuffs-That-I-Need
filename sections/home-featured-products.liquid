<section class="home-featured-products">
  <div class="page-width">
    {% assign featured_collection = section.settings.collection %}
    {% if featured_collection == blank %}
      {% assign featured_collection = collections.all %}
    {% endif %}

    <div class="section-heading">
      {% assign section_title = section.settings.heading %}
      {% if section_title == blank %}
        {% assign section_title = 'home.products.title' | t %}
      {% endif %}
      <p class="section-heading__eyebrow">{{ 'home.products.kicker' | t }}</p>
      <h2>{{ section_title }}</h2>

      {% assign section_subtitle = section.settings.subheading %}
      {% if section_subtitle == blank %}
        {% assign section_subtitle = 'home.products.subtitle' | t %}
      {% endif %}
      <p>{{ section_subtitle }}</p>
    </div>

    {% if featured_collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <article class="product-card">
            <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: class: 'product-card__image', alt: product.featured_image.alt | default: product.title }}
              {% else %}
                <div class="product-card__placeholder">{{ 'home.products.empty_state' | t }}</div>
              {% endif %}
            </a>

            <div class="product-card__body">
              <div class="product-card__meta">
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__badge">{{ 'home.products.promo' | t }}</span>
                {% endif %}
              </div>

              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>

              <div class="product-card__pricing">
                <span class="product-card__price">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__compare-price">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="product-empty">
        <h3>{{ 'home.products.empty_title' | t }}</h3>
        <p>{{ 'home.products.empty_text' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .home-featured-products {
    padding: 5rem 0 0;
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .section-heading__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-muted);
    margin-bottom: 0.75rem;
  }

  .section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    letter-spacing: -0.06em;
    line-height: 0.96;
    margin-bottom: 0.8rem;
  }

  .section-heading p:last-child {
    color: var(--brand-muted);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .product-card {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--brand-border);
    border-radius: 1.5rem;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .product-card:hover,
  .product-card:focus-within {
    transform: translateY(-3px);
    border-color: rgba(36, 36, 36, 0.2);
  }

  .product-card__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #efece6;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image,
  .product-card:focus-within .product-card__image {
    transform: scale(1.03);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #f3f0e8, #efeefb);
    font-weight: 600;
    color: var(--brand-muted);
  }

  .product-card__body {
    padding: 1rem 1rem 1.2rem;
  }

  .product-card__meta {
    min-height: 1.5rem;
  }

  .product-card__badge {
    display: inline-flex;
    border-radius: 999px;
    background: var(--brand-lime);
    color: var(--brand-charcoal);
    padding: 0.25rem 0.5rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card h3 {
    font-size: 1.05rem;
    letter-spacing: -0.04em;
    margin: 0.7rem 0 0.7rem;
  }

  .product-card__pricing {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .product-card__price {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .product-card__compare-price {
    font-size: 0.86rem;
    color: var(--brand-muted);
    text-decoration: line-through;
  }

  .product-empty {
    border: 1px dashed var(--brand-border);
    border-radius: 1.5rem;
    padding: 3rem 1.25rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.4);
  }

  .product-empty h3 {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 980px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pequenas coisas. Grandes vontades."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Os achadinhos que merecem um lugar na sua rotina."
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
