<section class="home-hero">
  <div class="page-width home-hero__layout">
    <div class="home-hero__content">
      {% assign hero_title = section.settings.heading %}
      {% if hero_title == blank %}
        {% assign hero_title = 'home.hero.title' | t %}
      {% endif %}
      <h1>{{ hero_title }}</h1>

      {% assign hero_subheading = section.settings.subheading %}
      {% if hero_subheading == blank %}
        {% assign hero_subheading = 'home.hero.subtitle' | t %}
      {% endif %}
      <p class="home-hero__subtitle">{{ hero_subheading }}</p>

      {% assign primary_label = section.settings.button_label %}
      {% if primary_label == blank %}
        {% assign primary_label = 'home.hero.cta_primary' | t %}
      {% endif %}

      <div class="home-hero__actions">
        <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ primary_label }}</a>
        {% if section.settings.secondary_link != blank %}
          {% assign secondary_label = section.settings.secondary_label %}
          {% if secondary_label == blank %}
            {% assign secondary_label = 'home.hero.cta_secondary' | t %}
          {% endif %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ secondary_label }}</a>
        {% endif %}
      </div>
    </div>

    {% assign hero_image = section.settings.image %}
    <div class="home-hero__visual">
      <svg class="home-hero__orbit" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
        <ellipse cx="300" cy="300" rx="230" ry="184" transform="rotate(-18 300 300)" fill="none" stroke="#172B4D" stroke-opacity="0.24" stroke-width="1.5" stroke-dasharray="2 10"/>
        <circle cx="91" cy="226" r="5" fill="#172B4D"/>
        <circle cx="472" cy="390" r="4" fill="#172B4D"/>
        <path d="M461 119v25m-12.5-12.5h25M143 438v18m-9-9h18" fill="none" stroke="#172B4D" stroke-linecap="round" stroke-width="2"/>
        <path d="m420 464 4 10 10 4-10 4-4 10-4-10-10-4 10-4 4-10Zm-273-331 3 7 7 3-7 3-3 7-3-7-7-3 7-3 3-7Z" fill="#172B4D"/>
      </svg>

      {% if hero_image != blank %}
        {{ hero_image | image_url: width: 1200 | image_tag:
          class: 'home-hero__image',
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(min-width: 821px) 42vw, 78vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_image.alt | default: hero_title
        }}
      {% else %}
        <svg class="home-hero__illustration" viewBox="0 0 520 520" role="img" aria-label="{{ 'home.hero.visual_label' | t }}" focusable="false">
          <circle cx="260" cy="260" r="191" fill="#FFFFFF"/>
          <circle cx="260" cy="260" r="190" fill="none" stroke="#172B4D" stroke-opacity="0.16" stroke-width="2"/>
          <path d="M260 105c-72 0-127 55-127 124 0 46 24 78 51 108 14 16 22 34 24 53h104c2-19 10-37 24-53 27-30 51-62 51-108 0-69-55-124-127-124Z" fill="#FFFFFF" stroke="#172B4D" stroke-linejoin="round" stroke-width="5"/>
          <path d="M236 390h48m-43 15h38m-31 15h24" fill="none" stroke="#172B4D" stroke-linecap="round" stroke-width="7"/>
          <path d="m260 159 14 35 37 2-29 23 10 36-32-20-32 20 10-36-29-23 37-2 14-35Z" fill="#FFFFFF" stroke="#172B4D" stroke-linejoin="round" stroke-width="4"/>
          <path d="m103 300 4 11 11 4-11 4-4 11-4-11-11-4 11-4 4-11Zm316-79 4 11 11 4-11 4-4 11-4-11-11-4 11-4 4-11Z" fill="#172B4D"/>
          <circle cx="127" cy="191" r="7" fill="#172B4D"/>
          <circle cx="394" cy="337" r="6" fill="#172B4D"/>
        </svg>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .home-hero {
    position: relative;
    padding: clamp(2.5rem, 5vw, 5rem) 0 clamp(2.5rem, 4vw, 3.75rem);
    background: #FFFFFF;
  }

  .home-hero__layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4.5rem);
    padding: clamp(0.5rem, 2vw, 1.5rem) 0;
  }

  .home-hero__content {
    position: relative;
    display: grid;
    align-content: center;
    max-width: 36rem;
    padding-right: clamp(0rem, 2vw, 1rem);
  }

  .home-hero__content::before {
    content: "";
    position: absolute;
    left: -1rem;
    top: 3.6rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-navy);
    box-shadow: 0 0 0 8px rgba(23, 43, 77, 0.08);
  }

  .home-hero h1 {
    position: relative;
    z-index: 0;
    display: inline-block;
    max-width: 12ch;
    margin-bottom: 1rem;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .home-hero h1::before {
    content: "";
    position: absolute;
    left: -0.18em;
    right: -0.12em;
    bottom: 0.14em;
    height: 0.46em;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(23, 43, 77, 0.14), rgba(23, 43, 77, 0.05));
    z-index: -1;
    transform: rotate(-2deg);
  }

  .home-hero__subtitle {
    max-width: 32rem;
    margin-bottom: 1.8rem;
    color: var(--brand-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.6;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .home-hero__actions .button {
    box-shadow: 0 12px 24px rgba(36, 36, 36, 0.08);
    border: 1px solid transparent;
  }

  .home-hero__actions .button--primary {
    background: var(--brand-charcoal);
  }

  .home-hero__actions .button--secondary {
    background: rgba(255, 255, 255, 0.45);
    border-color: rgba(36, 36, 36, 0.1);
  }

  .home-hero__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(22rem, 33vw, 30rem);
    isolation: isolate;
  }

  .home-hero__visual::before {
    position: absolute;
    z-index: -1;
    width: min(76%, 25rem);
    aspect-ratio: 1;
    border-radius: 46% 54% 63% 37% / 48% 40% 60% 52%;
    background: #F7F7F7;
    content: "";
    transform: rotate(-12deg);
  }

  .home-hero__visual::after {
    position: absolute;
    z-index: -1;
    right: 8%;
    bottom: 10%;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--brand-navy);
    box-shadow: 0 0 0 0.45rem rgba(23, 43, 77, 0.08);
    content: "";
  }

  .home-hero__orbit {
    position: absolute;
    z-index: 0;
    width: min(100%, 35rem);
    height: auto;
    overflow: visible;
    animation: hero-orbit-drift 18s ease-in-out infinite alternate;
  }

  .home-hero__image,
  .home-hero__illustration {
    position: relative;
    z-index: 1;
    display: block;
    width: min(100%, 30rem);
    max-height: clamp(22rem, 38vw, 32rem);
    aspect-ratio: 1;
    object-fit: contain;
  }

  .home-hero__image {
    filter: drop-shadow(0 1.2rem 1.4rem rgba(23, 43, 77, 0.12));
  }

  .home-hero__illustration {
    overflow: visible;
    filter: drop-shadow(0 1rem 1rem rgba(23, 43, 77, 0.08));
  }

  @keyframes hero-orbit-drift {
    from {
      transform: rotate(-3deg) scale(0.98);
    }
    to {
      transform: rotate(3deg) scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__orbit {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .home-hero__layout {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .home-hero__content {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .home-hero__layout {
      gap: 1rem;
    }

    .home-hero h1 {
      max-width: 10ch;
    }

    .home-hero__visual {
      min-height: clamp(18.5rem, 74vw, 25rem);
    }

    .home-hero__image,
    .home-hero__illustration {
      width: min(100%, 24rem);
      max-height: 24rem;
    }

    .home-hero__orbit {
      width: 112%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Você não precisa. Mas vai querer."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Achadinhos, objetos curiosos e pequenas coisas que deixam o dia mais interessante."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explorar produtos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Ver coleções"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
