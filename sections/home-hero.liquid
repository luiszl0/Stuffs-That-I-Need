<section class="home-hero">
  <div class="page-width home-hero__layout">
    <div class="home-hero__content">
      {% assign hero_eyebrow = section.settings.eyebrow %}
      {% if hero_eyebrow == blank %}
        {% assign hero_eyebrow = 'home.hero.eyebrow' | t %}
      {% endif %}
      <p class="home-hero__eyebrow">{{ hero_eyebrow }}</p>

      {% assign hero_title = section.settings.heading %}
      {% if hero_title == blank %}
        {% assign hero_title = 'home.hero.title' | t %}
      {% endif %}
      <h1>{{ hero_title }}</h1>

      {% assign hero_subheading = section.settings.subheading %}
      {% if hero_subheading == blank %}
        {% assign hero_subheading = 'home.hero.subtitle' | t %}
      {% endif %}
      <p class="home-hero__subtitle">{{ hero_subheading }}</p>

      {% assign primary_label = section.settings.button_label %}
      {% if primary_label == blank %}
        {% assign primary_label = 'home.hero.cta_primary' | t %}
      {% endif %}

      <div class="home-hero__actions">
        <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ primary_label }}</a>
        {% if section.settings.secondary_link != blank %}
          {% assign secondary_label = section.settings.secondary_label %}
          {% if secondary_label == blank %}
            {% assign secondary_label = 'home.hero.cta_secondary' | t %}
          {% endif %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ secondary_label }}</a>
        {% endif %}
      </div>
    </div>

    <div class="home-hero__visual" aria-label="{{ 'home.hero.visual_label' | t }}">
      <div class="home-hero__card home-hero__card--main">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'home-hero__image', loading: 'eager', alt: section.settings.image.alt | default: hero_title }}
        {% else %}
          <div class="home-hero__placeholder">
            <span>{{ 'home.hero.placeholder' | t }}</span>
          </div>
        {% endif %}
      </div>

      <div class="home-hero__card home-hero__card--lime">
        <p>{{ 'home.hero.card_title' | t }}</p>
        <strong>{{ 'home.hero.card_value' | t }}</strong>
      </div>

      <div class="home-hero__card home-hero__card--soft">
        <p>{{ 'home.hero.card_label' | t }}</p>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .home-hero {
    padding: clamp(3rem, 5vw, 5rem) 0 0;
  }

  .home-hero__layout {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .home-hero__content {
    max-width: 36rem;
  }

  .home-hero__eyebrow {
    display: inline-flex;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: rgba(168, 199, 255, 0.45);
    color: var(--brand-charcoal);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .home-hero h1 {
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.88;
    letter-spacing: -0.07em;
    margin-bottom: 1.2rem;
  }

  .home-hero__subtitle {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    max-width: 31rem;
    color: var(--brand-muted);
    margin-bottom: 1.8rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .home-hero__visual {
    position: relative;
    min-height: 34rem;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, rgba(168, 199, 255, 0.28), rgba(255, 182, 159, 0.18));
    border: 1px solid rgba(36, 36, 36, 0.05);
    border-radius: 2rem;
    overflow: hidden;
  }

  .home-hero__visual::before,
  .home-hero__visual::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    background: rgba(216, 240, 106, 0.32);
  }

  .home-hero__visual::before {
    width: 18rem;
    height: 18rem;
    top: -4rem;
    right: -3rem;
  }

  .home-hero__visual::after {
    width: 14rem;
    height: 14rem;
    left: -2rem;
    bottom: -2rem;
    background: rgba(255, 182, 159, 0.28);
  }

  .home-hero__card {
    position: absolute;
    z-index: 1;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(36, 36, 36, 0.05);
    border-radius: 1.4rem;
    box-shadow: 0 12px 30px var(--brand-shadow);
    overflow: hidden;
  }

  .home-hero__card--main {
    inset: 2rem 1.5rem 1.9rem 1.5rem;
    display: flex;
    align-items: stretch;
    justify-content: center;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1.5rem;
    box-shadow: 0 14px 40px rgba(36, 36, 36, 0.08);
  }

  .home-hero__placeholder {
    width: 100%;
    min-height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--brand-lime), #eef8b7);
    border-radius: 1.5rem;
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    text-align: center;
    padding: 2rem;
  }

  .home-hero__card--lime {
    right: 1.3rem;
    bottom: 1.2rem;
    padding: 1rem 1.2rem;
    background: var(--brand-lime);
    min-width: 11rem;
  }

  .home-hero__card--lime p,
  .home-hero__card--soft p {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-muted);
    margin-bottom: 0.25rem;
  }

  .home-hero__card--lime strong {
    font-size: 1.3rem;
    letter-spacing: -0.04em;
  }

  .home-hero__card--soft {
    left: 1.2rem;
    top: 1.2rem;
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 820px) {
    .home-hero__layout {
      grid-template-columns: 1fr;
    }

    .home-hero__visual {
      min-height: 26rem;
    }

    .home-hero__content {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Nova seleção"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Você não precisa. Mas vai querer."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Achadinhos, objetos curiosos e pequenas coisas que deixam o dia mais interessante."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explorar produtos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Ver coleções"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
