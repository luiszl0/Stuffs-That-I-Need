<section class="home-hero">
  <div class="page-width home-hero__layout">
    <div class="home-hero__content">
      {% assign hero_eyebrow = section.settings.eyebrow %}
      {% if hero_eyebrow == blank %}
        {% assign hero_eyebrow = 'home.hero.eyebrow' | t %}
      {% endif %}
      <p class="home-hero__eyebrow">{{ hero_eyebrow }}</p>

      {% assign hero_title = section.settings.heading %}
      {% if hero_title == blank %}
        {% assign hero_title = 'home.hero.title' | t %}
      {% endif %}
      <h1>{{ hero_title }}</h1>

      {% assign hero_subheading = section.settings.subheading %}
      {% if hero_subheading == blank %}
        {% assign hero_subheading = 'home.hero.subtitle' | t %}
      {% endif %}
      <p class="home-hero__subtitle">{{ hero_subheading }}</p>

      {% assign primary_label = section.settings.button_label %}
      {% if primary_label == blank %}
        {% assign primary_label = 'home.hero.cta_primary' | t %}
      {% endif %}

      <div class="home-hero__actions">
        <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ primary_label }}</a>
        {% if section.settings.secondary_link != blank %}
          {% assign secondary_label = section.settings.secondary_label %}
          {% if secondary_label == blank %}
            {% assign secondary_label = 'home.hero.cta_secondary' | t %}
          {% endif %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ secondary_label }}</a>
        {% endif %}
      </div>
    </div>

    {% assign hero_image = section.settings.image %}
    {% if hero_image == blank %}
      {% assign hero_product = all_products['brinquedo-anti-stress-squishy-em-formato-de-manteiga-e-queijo-elastic-stick'] %}
      {% assign hero_image = hero_product.featured_image %}
      {% if hero_product.images.size > 2 %}
        {% assign hero_image = hero_product.images[2] %}
      {% endif %}
    {% endif %}

    <div class="home-hero__visual" role="group" aria-label="{{ 'home.hero.visual_label' | t }}">
      <div class="home-hero__visual-stage">
        <div class="home-hero__photo">
          {% if hero_image != blank %}
            {{ hero_image | image_url: width: 1000 | image_tag:
              class: 'home-hero__image',
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 821px) 20vw, (min-width: 561px) 34vw, 42vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_image.alt | default: hero_title
            }}
          {% else %}
            <div class="home-hero__placeholder">
              <span>{{ 'home.hero.placeholder' | t }}</span>
            </div>
          {% endif %}
        </div>

        <div class="home-hero__visual-copy">
          <p class="home-hero__visual-title">{{ 'home.hero.visual_title' | t }}</p>
          <p>{{ 'home.hero.visual_point_one' | t }}</p>
          <p>{{ 'home.hero.visual_point_two' | t }}</p>
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ 'home.hero.visual_cta' | t }}
          </a>
        </div>
      </div>

      <div class="home-hero__card home-hero__card--soft">
        <p>{{ 'home.hero.card_label' | t }}</p>
      </div>

      <div class="home-hero__card home-hero__card--lime">
        <p>{{ 'home.hero.card_title' | t }}</p>
        <strong>{{ 'home.hero.card_value' | t }}</strong>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .home-hero {
    padding: clamp(2.5rem, 4vw, 3.75rem) 0 0;
  }

  .home-hero__layout {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .home-hero__content {
    max-width: 36rem;
  }

  .home-hero__eyebrow {
    display: inline-flex;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: rgba(168, 199, 255, 0.45);
    color: var(--brand-charcoal);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .home-hero h1 {
    font-size: clamp(2.5rem, 4.7vw, 4.25rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    margin-bottom: 1rem;
  }

  .home-hero__subtitle {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    max-width: 31rem;
    color: var(--brand-muted);
    margin-bottom: 1.8rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .home-hero__visual {
    position: relative;
    display: flex;
    min-height: clamp(19rem, 27vw, 24rem);
    padding: 1rem;
    background: linear-gradient(145deg, rgba(168, 199, 255, 0.3), rgba(255, 182, 159, 0.28));
    border: 1px solid rgba(36, 36, 36, 0.05);
    border-radius: 1.75rem;
    overflow: hidden;
  }

  .home-hero__visual::before,
  .home-hero__visual::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    background: rgba(216, 240, 106, 0.32);
  }

  .home-hero__visual::before {
    width: 14rem;
    height: 14rem;
    top: -4rem;
    right: -3rem;
  }

  .home-hero__visual::after {
    width: 11rem;
    height: 11rem;
    left: -2rem;
    bottom: -2rem;
    background: rgba(255, 182, 159, 0.28);
  }

  .home-hero__card {
    position: absolute;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(36, 36, 36, 0.05);
    border-radius: 1rem;
    box-shadow: 0 8px 22px var(--brand-shadow);
    overflow: hidden;
  }

  .home-hero__visual-stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: 1rem;
    flex: 1;
    width: 100%;
    height: calc(clamp(19rem, 27vw, 24rem) - 2rem);
    min-height: 0;
    padding: 1rem;
    border-radius: 1.25rem;
    background: rgba(216, 240, 106, 0.92);
  }

  .home-hero__photo {
    min-width: 0;
    align-self: center;
    aspect-ratio: 1;
    height: auto;
    min-height: 0;
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 10px 28px rgba(36, 36, 36, 0.12);
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--brand-lime), #eef8b7);
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    text-align: center;
    padding: 1rem;
  }

  .home-hero__visual-copy {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem 0.75rem;
  }

  .home-hero__visual-copy p {
    margin: 0;
    color: var(--brand-charcoal);
    font-size: clamp(0.76rem, 1vw, 0.9rem);
    line-height: 1.45;
  }

  .home-hero__visual-copy .home-hero__visual-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .home-hero__visual-copy a {
    width: fit-content;
    border-bottom: 1px solid currentColor;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .home-hero__card--soft {
    z-index: 2;
    top: 1.25rem;
    left: 1.25rem;
    padding: 0.55rem 0.75rem;
    background: rgba(255, 255, 255, 0.9);
  }

  .home-hero__card--soft p {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--brand-charcoal);
  }

  .home-hero__card--lime {
    z-index: 2;
    right: 1.25rem;
    bottom: 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--brand-lime);
    min-width: 8.5rem;
  }

  .home-hero__card--lime p {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-muted);
    margin-bottom: 0.25rem;
  }

  .home-hero__card--lime strong {
    font-size: 1.15rem;
    letter-spacing: -0.04em;
  }

  @media (max-width: 820px) {
    .home-hero__layout {
      grid-template-columns: 1fr;
    }

    .home-hero__visual {
      min-height: clamp(19rem, 58vw, 24rem);
    }

    .home-hero__visual-stage {
      height: calc(clamp(19rem, 58vw, 24rem) - 2rem);
    }

    .home-hero__content {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .home-hero__visual {
      padding: 0.75rem;
      min-height: 19rem;
    }

    .home-hero__visual-stage {
      min-height: 17.5rem;
      height: 17.5rem;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 0.65rem;
      padding: 0.7rem;
    }

    .home-hero__photo {
      min-height: 0;
    }

    .home-hero__visual-copy {
      gap: 0.5rem;
      padding: 1.5rem 0.15rem 0.25rem;
    }

    .home-hero__visual-copy p {
      font-size: 0.68rem;
    }

    .home-hero__visual-copy .home-hero__visual-title {
      font-size: 0.95rem;
    }

    .home-hero__card--soft {
      top: 1rem;
      left: 1rem;
      padding: 0.45rem 0.6rem;
    }

    .home-hero__card--soft p {
      font-size: 0.52rem;
    }

    .home-hero__card--lime {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Nova seleção"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Você não precisa. Mas vai querer."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Achadinhos, objetos curiosos e pequenas coisas que deixam o dia mais interessante."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explorar produtos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Ver coleções"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
