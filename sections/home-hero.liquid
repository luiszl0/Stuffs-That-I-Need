<section class="home-hero">
  <div class="page-width home-hero__layout">
    <div class="home-hero__content">
      {% assign hero_eyebrow = section.settings.eyebrow %}
      {% if hero_eyebrow == blank %}
        {% assign hero_eyebrow = 'home.hero.eyebrow' | t %}
      {% endif %}
      <p class="home-hero__eyebrow">{{ hero_eyebrow }}</p>

      {% assign hero_title = section.settings.heading %}
      {% if hero_title == blank %}
        {% assign hero_title = 'home.hero.title' | t %}
      {% endif %}
      <h1>{{ hero_title }}</h1>

      {% assign hero_subheading = section.settings.subheading %}
      {% if hero_subheading == blank %}
        {% assign hero_subheading = 'home.hero.subtitle' | t %}
      {% endif %}
      <p class="home-hero__subtitle">{{ hero_subheading }}</p>

      {% assign primary_label = section.settings.button_label %}
      {% if primary_label == blank %}
        {% assign primary_label = 'home.hero.cta_primary' | t %}
      {% endif %}

      <div class="home-hero__actions">
        <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ primary_label }}</a>
        {% if section.settings.secondary_link != blank %}
          {% assign secondary_label = section.settings.secondary_label %}
          {% if secondary_label == blank %}
            {% assign secondary_label = 'home.hero.cta_secondary' | t %}
          {% endif %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ secondary_label }}</a>
        {% endif %}
      </div>
    </div>

    {% assign hero_image = section.settings.image %}
    {% if hero_image == blank %}
      {% assign hero_product = all_products['brinquedo-anti-stress-squishy-em-formato-de-manteiga-e-queijo-elastic-stick'] %}
      {% assign hero_image = hero_product.featured_image %}
      {% if hero_product.images.size > 2 %}
        {% assign hero_image = hero_product.images[2] %}
      {% endif %}
    {% endif %}

    <div class="home-hero__visual" role="group" aria-label="{{ 'home.hero.visual_label' | t }}">
      <div class="home-hero__visual-stage">
        <div class="home-hero__photo">
          {% if hero_image != blank %}
            {{ hero_image | image_url: width: 1000 | image_tag:
              class: 'home-hero__image',
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 821px) 32vw, (min-width: 561px) 42vw, 52vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_image.alt | default: hero_title
            }}
          {% else %}
            <div class="home-hero__placeholder">
              <span>{{ 'home.hero.placeholder' | t }}</span>
            </div>
          {% endif %}
        </div>

        <div class="home-hero__visual-copy">
          <p class="home-hero__visual-title">{{ 'home.hero.visual_title' | t }}</p>
          <p>{{ 'home.hero.visual_point_one' | t }}</p>
          <p>{{ 'home.hero.visual_point_two' | t }}</p>
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ 'home.hero.visual_cta' | t }}
          </a>
        </div>
      </div>

      <div class="home-hero__card home-hero__card--soft">
        <p>{{ 'home.hero.card_label' | t }}</p>
      </div>

      <div class="home-hero__card home-hero__card--lime">
        <p>{{ 'home.hero.card_title' | t }}</p>
        <strong>{{ 'home.hero.card_value' | t }}</strong>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .home-hero {
    position: relative;
    padding: clamp(2.5rem, 5vw, 5rem) 0 clamp(2.5rem, 4vw, 3.75rem);
    background:
      radial-gradient(circle at top left, rgba(169, 199, 255, 0.48), transparent 29%),
      radial-gradient(circle at 82% 18%, rgba(255, 182, 159, 0.25), transparent 24%),
      linear-gradient(180deg, rgba(247, 245, 239, 0.98), rgba(247, 245, 239, 1));
  }

  .home-hero__layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4.5rem);
    padding: clamp(0.5rem, 2vw, 1.5rem) 0;
  }

  .home-hero__content {
    position: relative;
    display: grid;
    align-content: center;
    max-width: 36rem;
    padding-right: clamp(0rem, 2vw, 1rem);
  }

  .home-hero__content::before {
    content: "";
    position: absolute;
    left: -1rem;
    top: 3.6rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-lime);
    box-shadow: 0 0 0 8px rgba(216, 240, 106, 0.22);
  }

  .home-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.5rem 0.8rem;
    margin-bottom: 1.1rem;
    border: 1px solid rgba(36, 36, 36, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 10px 20px rgba(36, 36, 36, 0.04);
    color: var(--brand-charcoal);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .home-hero h1 {
    position: relative;
    z-index: 0;
    display: inline-block;
    max-width: 12ch;
    margin-bottom: 1rem;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .home-hero h1::before {
    content: "";
    position: absolute;
    left: -0.18em;
    right: -0.12em;
    bottom: 0.14em;
    height: 0.46em;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(216, 240, 106, 0.88), rgba(216, 240, 106, 0.62));
    z-index: -1;
    transform: rotate(-2deg);
  }

  .home-hero__subtitle {
    max-width: 32rem;
    margin-bottom: 1.8rem;
    color: var(--brand-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.6;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .home-hero__actions .button {
    box-shadow: 0 12px 24px rgba(36, 36, 36, 0.08);
    border: 1px solid transparent;
  }

  .home-hero__actions .button--primary {
    background: linear-gradient(180deg, #2b2b2b, #181818);
  }

  .home-hero__actions .button--secondary {
    background: rgba(255, 255, 255, 0.45);
    border-color: rgba(36, 36, 36, 0.1);
  }

  .home-hero__visual {
    position: relative;
    display: flex;
    min-height: clamp(22rem, 33vw, 30rem);
    padding: clamp(0.75rem, 1.3vw, 1.15rem);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.18));
    border: 1px solid rgba(36, 36, 36, 0.06);
    border-radius: 2rem;
    box-shadow: 0 28px 60px rgba(36, 36, 36, 0.08);
    overflow: hidden;
    isolation: isolate;
  }

  .home-hero__visual::before,
  .home-hero__visual::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
  }

  .home-hero__visual::before {
    width: 16rem;
    height: 16rem;
    top: -4.75rem;
    right: -2.8rem;
    background: rgba(216, 240, 106, 0.42);
  }

  .home-hero__visual::after {
    width: 13rem;
    height: 13rem;
    left: -3rem;
    bottom: -3.5rem;
    background: rgba(255, 182, 159, 0.3);
  }

  .home-hero__card {
    position: absolute;
    z-index: 2;
    border: 1px solid rgba(36, 36, 36, 0.08);
    border-radius: 1rem;
    box-shadow: 0 12px 30px rgba(36, 36, 36, 0.1);
    backdrop-filter: blur(10px);
    transform: translateZ(0);
  }

  .home-hero__visual-stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 1rem;
    flex: 1;
    width: 100%;
    height: calc(clamp(22rem, 33vw, 30rem) - 2rem);
    min-height: 0;
    padding: 1rem;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, rgba(216, 240, 106, 0.96), rgba(236, 245, 191, 0.88));
    border: 1px solid rgba(36, 36, 36, 0.05);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .home-hero__photo {
    min-width: 0;
    align-self: center;
    aspect-ratio: 1;
    height: auto;
    min-height: 0;
    border-radius: 1.2rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 14px 28px rgba(36, 36, 36, 0.12);
    border: 1px solid rgba(36, 36, 36, 0.04);
    transform: rotate(-2deg);
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.08) contrast(1.03);
  }

  .home-hero__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--brand-lime), #eef8b7);
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    text-align: center;
    padding: 1rem;
  }

  .home-hero__visual-copy {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
    padding: 1rem 0.75rem 1rem 0.45rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(36, 36, 36, 0.06);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
  }

  .home-hero__visual-copy p {
    margin: 0;
    color: var(--brand-charcoal);
    font-size: clamp(0.76rem, 1vw, 0.9rem);
    line-height: 1.45;
  }

  .home-hero__visual-copy .home-hero__visual-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .home-hero__visual-copy a {
    width: fit-content;
    border-bottom: 1px solid currentColor;
    font-size: 0.75rem;
    font-weight: 700;
    transition: opacity 0.2s ease;
  }

  .home-hero__visual-copy a:hover,
  .home-hero__visual-copy a:focus-visible {
    opacity: 0.7;
  }

  .home-hero__card--soft {
    top: 1.2rem;
    left: 1.2rem;
    padding: 0.55rem 0.8rem;
    background: rgba(255, 255, 255, 0.82);
  }

  .home-hero__card--soft p {
    margin: 0;
    color: var(--brand-charcoal);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__card--lime {
    right: 1.3rem;
    bottom: 1.3rem;
    min-width: 9rem;
    padding: 0.8rem 1rem;
    background: var(--brand-lime);
    box-shadow: 0 18px 32px rgba(36, 36, 36, 0.12);
  }

  .home-hero__card--lime p {
    margin: 0 0 0.25rem;
    color: var(--brand-muted);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__card--lime strong {
    display: block;
    font-size: 1.15rem;
    letter-spacing: -0.04em;
  }

  @media (max-width: 820px) {
    .home-hero__layout {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .home-hero__visual {
      min-height: clamp(19rem, 58vw, 24rem);
    }

    .home-hero__visual-stage {
      height: calc(clamp(19rem, 58vw, 24rem) - 2rem);
    }

    .home-hero__content {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .home-hero__layout {
      gap: 1rem;
    }

    .home-hero h1 {
      max-width: 10ch;
    }

    .home-hero__visual {
      min-height: 18.5rem;
      padding: 0.75rem;
    }

    .home-hero__visual-stage {
      height: 17rem;
      min-height: 17rem;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 0.6rem;
      padding: 0.7rem;
    }

    .home-hero__photo {
      min-height: 0;
    }

    .home-hero__visual-copy {
      gap: 0.5rem;
      padding: 1rem 0.15rem 0.25rem 0.2rem;
    }

    .home-hero__visual-copy p {
      font-size: 0.68rem;
    }

    .home-hero__visual-copy .home-hero__visual-title {
      font-size: 0.95rem;
    }

    .home-hero__card--soft {
      top: 0.9rem;
      left: 0.9rem;
      padding: 0.45rem 0.6rem;
    }

    .home-hero__card--soft p {
      font-size: 0.52rem;
    }

    .home-hero__card--lime {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Nova seleção"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Você não precisa. Mas vai querer."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Achadinhos, objetos curiosos e pequenas coisas que deixam o dia mais interessante."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explorar produtos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Ver coleções"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
