<section class="home-hero">
  <div class="page-width">
    <div class="home-hero__topline">
      <span>{{ 'home.hero.kicker' | t }}</span>
      <span aria-hidden="true">01 — 04</span>
    </div>

    <div class="home-hero__layout">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow"><span></span>{{ 'home.hero.eyebrow' | t }}</p>
        {% assign hero_title = section.settings.heading %}
        {% if hero_title == blank %}
          {% assign hero_title = 'home.hero.title' | t %}
        {% endif %}
        <h1>{{ hero_title | escape }}</h1>

        {% assign hero_subheading = section.settings.subheading %}
        {% if hero_subheading == blank %}
          {% assign hero_subheading = 'home.hero.subtitle' | t %}
        {% endif %}
        <p class="home-hero__subtitle">{{ hero_subheading | escape }}</p>

        {% assign primary_label = section.settings.button_label %}
        {% if primary_label == blank %}
          {% assign primary_label = 'home.hero.cta_primary' | t %}
        {% endif %}

        <div class="home-hero__actions">
          <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ primary_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
          <span class="home-hero__note">{{ 'home.hero.note' | t }}</span>
        </div>
      </div>

      {% assign hero_image = section.settings.image %}
      <div class="home-hero__visual">
        <span class="home-hero__visual-index" aria-hidden="true">FIG. 001</span>
        <span class="home-hero__visual-stamp" aria-hidden="true">{{ 'home.hero.stamp' | t }}</span>
        <div class="home-hero__art">
          {% if hero_image != blank %}
            {{ hero_image | image_url: width: 1400 | image_tag:
              class: 'home-hero__image',
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 900px) 48vw, 92vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_image.alt | default: hero_title
            }}
          {% else %}
            <svg class="home-hero__illustration" viewBox="0 0 720 800" role="img" aria-label="{{ 'home.hero.visual_label' | t }}" focusable="false">
              <circle cx="394" cy="387" r="239" fill="#F2EFE7"/>
              <circle cx="394" cy="387" r="213" fill="none" stroke="#111111" stroke-width="2"/>
              <path d="M394 148v-38m0 553v-38M155 387h-38m553 0h-38M225 218l-27-27m391 391-27-27m0-337 27-27M198 583l27-27" stroke="#111111" stroke-width="2"/>
              <path d="M394 205c-101 0-183 82-183 183 0 67 35 115 74 158 21 23 32 50 35 77h148c3-27 14-54 35-77 39-43 74-91 74-158 0-101-82-183-183-183Z" fill="#2448E8" stroke="#111111" stroke-width="8" stroke-linejoin="round"/>
              <path d="M344 622h100m-88 24h76m-61 24h46" stroke="#111111" stroke-width="10" stroke-linecap="square"/>
              <path d="m394 278 33 68 75 11-54 53 13 75-67-36-67 36 13-75-54-53 75-11 33-68Z" fill="#FFFDF8" stroke="#111111" stroke-width="6" stroke-linejoin="round"/>
              <circle cx="394" cy="387" r="270" fill="none" stroke="#FFFDF8" stroke-width="2" stroke-dasharray="2 14"/>
              <path d="m138 493 11 29 30 11-30 11-11 29-11-29-29-11 29-11 11-29Zm484-355 9 23 24 9-24 9-9 24-9-24-24-9 24-9 9-23Z" fill="#FFFDF8"/>
              <circle cx="601" cy="598" r="31" fill="#111111"/>
              <circle cx="603" cy="596" r="24" fill="#2448E8"/>
            </svg>
          {% endif %}
        </div>
        <p class="home-hero__caption">{{ 'home.hero.caption' | t }}</p>
      </div>
    </div>

    <div class="home-hero__bottomline">
      <span>{{ 'home.hero.bottom_note' | t }}</span>
      <span aria-hidden="true">↓</span>
    </div>
  </div>
</section>

{% stylesheet %}
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: 1rem 0 clamp(2.5rem, 5vw, 4.5rem);
    background: var(--brand-canvas);
  }

  .home-hero__topline,
  .home-hero__bottomline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px solid var(--brand-charcoal);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5.5rem);
    padding: clamp(1.5rem, 4vw, 3.5rem) 0;
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    max-width: 39rem;
    padding: 1.5rem 0;
  }

  .home-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    color: var(--brand-cobalt);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home-hero__eyebrow span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--brand-cobalt);
  }

  .home-hero h1 {
    max-width: 10ch;
    margin-bottom: 1.35rem;
    font-family: var(--font-display);
    font-size: clamp(3.7rem, 8.3vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.095em;
    line-height: 0.83;
    text-wrap: balance;
  }

  .home-hero h1 em {
    color: var(--brand-cobalt);
    font-style: normal;
  }

  .home-hero__subtitle {
    max-width: 27rem;
    margin-bottom: 1.75rem;
    color: var(--brand-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.65;
  }

  .home-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.1rem;
  }

  .home-hero__actions .button {
    min-width: 12rem;
    justify-content: space-between;
    padding-inline: 1.1rem;
  }

  .home-hero__actions .button span {
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  .home-hero__actions .button:hover span {
    transform: translate(2px, -2px);
  }

  .home-hero__note {
    max-width: 9rem;
    color: var(--brand-muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .home-hero__visual {
    position: relative;
    min-height: clamp(28rem, 48vw, 42rem);
    background: var(--brand-cobalt);
    isolation: isolate;
  }

  .home-hero__visual::before {
    position: absolute;
    z-index: -1;
    top: -21%;
    right: -21%;
    width: 69%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 253, 248, 0.4);
    border-radius: 50%;
    content: "";
  }

  .home-hero__visual::after {
    position: absolute;
    z-index: -1;
    bottom: -16%;
    left: -16%;
    width: 54%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 253, 248, 0.35);
    border-radius: 50%;
    content: "";
  }

  .home-hero__art {
    position: absolute;
    inset: 7% 7% 8%;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .home-hero__illustration,
  .home-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__illustration {
    overflow: visible;
    animation: hero-art-arrive 0.9s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  }

  .home-hero__image {
    object-fit: contain;
  }

  .home-hero__visual-index,
  .home-hero__visual-stamp,
  .home-hero__caption {
    position: absolute;
    z-index: 2;
    color: var(--brand-white);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-hero__visual-index {
    top: 1.1rem;
    left: 1.1rem;
  }

  .home-hero__visual-stamp {
    top: 1.25rem;
    right: 1.1rem;
    writing-mode: vertical-rl;
  }

  .home-hero__caption {
    right: 1.1rem;
    bottom: 1.1rem;
    left: 1.1rem;
    display: flex;
    justify-content: space-between;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 253, 248, 0.5);
  }

  .home-hero__bottomline {
    border-top: 0;
    border-bottom: 1px solid var(--brand-charcoal);
  }

  .home-hero__bottomline span:last-child {
    color: var(--brand-cobalt);
    font-size: 1.15rem;
  }

  @keyframes hero-art-arrive {
    from {
      opacity: 0;
      transform: scale(0.94) rotate(-5deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__illustration {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .home-hero__layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .home-hero__content {
      max-width: 40rem;
      padding-block: 1rem 0;
    }

    .home-hero h1 {
      max-width: 11ch;
      font-size: clamp(4rem, 12vw, 7rem);
    }

    .home-hero__visual {
      min-height: min(88vw, 38rem);
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      padding-top: 0.5rem;
    }

    .home-hero__topline,
    .home-hero__bottomline {
      font-size: 0.58rem;
    }

    .home-hero__layout {
      gap: 1.25rem;
      padding-block: 1.25rem;
    }

    .home-hero__eyebrow {
      margin-bottom: 1rem;
      font-size: 0.62rem;
    }

    .home-hero h1 {
      max-width: 10ch;
      font-size: clamp(3.5rem, 16vw, 5.3rem);
    }

    .home-hero__visual {
      min-height: min(105vw, 31rem);
    }

    .home-hero__art {
      inset: 8%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Useful things. Unexpected stories."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Objects with a point of view, chosen to surprise and made to find their way into your everyday."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
