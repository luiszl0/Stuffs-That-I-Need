<section class="home-brand-story">
  <div class="page-width home-brand-story__inner">
    <div class="home-brand-story__content">
      <p class="home-brand-story__eyebrow">{{ 'home.story.eyebrow' | t }}</p>
      <h2>{{ 'home.story.title' | t }}</h2>
      <p>{{ 'home.story.text' | t }}</p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}">{{ 'home.story.cta' | t }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .home-brand-story {
    padding-top: var(--section-space);
  }

  .home-brand-story__inner {
    position: relative;
    overflow: hidden;
    background: var(--brand-cobalt);
    color: var(--brand-white);
    padding: clamp(2rem, 6vw, 5rem);
  }

  .home-brand-story__inner::after {
    position: absolute;
    top: -38%;
    right: -5%;
    width: clamp(12rem, 32vw, 30rem);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 253, 248, 0.45);
    border-radius: 50%;
    box-shadow: 0 0 0 2.2rem rgba(255, 253, 248, 0.08), 0 0 0 4.4rem rgba(255, 253, 248, 0.06);
    content: "";
    pointer-events: none;
  }

  .home-brand-story__content {
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .home-brand-story__eyebrow {
    color: var(--brand-white);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .home-brand-story h2 {
    max-width: 13ch;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    letter-spacing: -0.09em;
    line-height: 0.88;
    margin-bottom: 0.9rem;
  }

  .home-brand-story p {
    color: rgba(255, 253, 248, 0.86);
    max-width: 32rem;
    margin-bottom: 1.5rem;
  }

  .home-brand-story .button--primary {
    border-color: var(--brand-white);
    background: var(--brand-white);
    color: var(--brand-charcoal);
  }

  .home-brand-story .button--primary:hover,
  .home-brand-story .button--primary:focus-visible {
    border-color: var(--brand-charcoal);
    background: var(--brand-charcoal);
    color: var(--brand-white);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nossa história",
  "settings": [],
  "presets": [
    {
      "name": "Nossa história",
      "category": "Página inicial"
    }
  ]
}
{% endschema %}
