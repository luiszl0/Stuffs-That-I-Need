{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="page-width blog-page">
  <header class="blog-page__header">
    <p>{{ 'blog.journal' | t }}</p>
    <h1>{{ blog.title }}</h1>
  </header>

  {% paginate blog.articles by 5 %}
    <div class="blog-page__grid">
    {% for article in blog.articles %}
      <article class="blog-page__card">
        {% if article.image %}
          <a class="blog-page__image" href="{{ article.url }}">
            {{ article.image | image_url: width: 1000 | image_tag: alt: article.image.alt | default: article.title, loading: 'lazy' }}
          </a>
        {% endif %}
        <h2>{{ article.title | link_to: article.url }}</h2>
        {% assign date = article.published_at | time_tag: format: 'date' %}
        <p class="blog-page__metadata">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
        <div class="blog-page__excerpt">{{ article.excerpt }}</div>
      </article>
    {% endfor %}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="blog-page__pagination">{{- paginate | default_pagination -}}</div>
    {%- endif -%}
  {% endpaginate %}
</div>

{% stylesheet %}
  .blog-page {
    padding-block: var(--section-space);
  }

  .blog-page__header {
    max-width: 58rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--brand-charcoal);
  }

  .blog-page__header > p {
    margin-bottom: 0.8rem;
    color: var(--brand-cobalt);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-page__header h1 {
    font-size: clamp(3.5rem, 9vw, 8rem);
    letter-spacing: -0.1em;
    line-height: 0.82;
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--brand-border);
    border: 1px solid var(--brand-border);
  }

  .blog-page__card {
    min-width: 0;
    padding: 1rem;
    background: var(--brand-canvas);
  }

  .blog-page__image {
    display: block;
    aspect-ratio: 4 / 3;
    margin: -1rem -1rem 1rem;
    overflow: hidden;
    background: var(--brand-pale-blue);
  }

  .blog-page__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .blog-page__image:hover img {
    transform: scale(1.03);
  }

  .blog-page__card h2 {
    margin-bottom: 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 2rem);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .blog-page__card h2 a:hover {
    color: var(--brand-cobalt);
  }

  .blog-page__metadata {
    margin-bottom: 0.7rem;
    color: var(--brand-muted);
    font-size: 0.75rem;
  }

  .blog-page__excerpt {
    color: var(--brand-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .blog-page__pagination {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  @media (max-width: 820px) {
    .blog-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .blog-page__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
