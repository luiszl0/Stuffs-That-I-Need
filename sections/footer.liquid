<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">{{ shop.name }}</p>
      <p class="site-footer__slogan">{{ 'home.footer.slogan' | t }}</p>
    </div>

    {% if shop.policies.size > 0 %}
      <div class="site-footer__links">
        <div class="site-footer__policies">
          <h3>Informações</h3>
          <ul>
            {% for policy in shop.policies %}
              <li>
                <a href="{{ policy.url }}">
                  {% if policy.url contains 'privacy-policy' %}
                    {{ 'policies.privacy' | t }}
                  {% elsif policy.url contains 'refund-policy' %}
                    {{ 'policies.returns' | t }}
                  {% elsif policy.url contains 'shipping-policy' %}
                    {{ 'policies.shipping' | t }}
                  {% elsif policy.url contains 'terms-of-service' %}
                    {{ 'policies.terms' | t }}
                  {% else %}
                    {{ policy.title }}
                  {% endif %}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_newsletter %}
      <div class="site-footer__newsletter">
        <h3>{{ 'home.footer.newsletter' | t }}</h3>
        {% form 'customer', class: 'site-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Seu e-mail" aria-label="Seu e-mail" required>
          <button type="submit">{{ 'home.footer.subscribe' | t }}</button>
        {% endform %}
      </div>
    {% endif %}
  </div>

  <div class="page-width site-footer__meta">
    <p>
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
    </p>
    {% if section.settings.show_payment_icons %}
      <div class="site-footer__payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background: var(--brand-charcoal);
    color: var(--brand-white);
    border-top: 1px solid var(--brand-charcoal);
    margin-top: 3rem;
    padding: 2.75rem 0 1.25rem;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 2rem;
    align-items: start;
  }

  .site-footer__name {
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    margin-bottom: 0.75rem;
  }

  .site-footer__slogan {
    color: rgba(255, 253, 248, 0.72);
    max-width: 22rem;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .site-footer__links h3,
  .site-footer__newsletter h3 {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
    color: rgba(255, 253, 248, 0.65);
  }

  .site-footer__links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .site-footer__newsletter .site-footer__form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .site-footer__newsletter input {
    flex: 1 1 12rem;
    min-height: 3rem;
    border: 1px solid var(--brand-border);
    border-radius: 999px;
    padding: 0 1rem;
    background: var(--brand-white);
  }

  .site-footer__newsletter button {
    min-height: 3rem;
    border: 0;
    border-radius: 999px;
    background: var(--brand-white);
    color: var(--brand-charcoal);
    padding: 0 1.2rem;
    cursor: pointer;
  }

  .site-footer__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--brand-border);
    color: rgba(255, 253, 248, 0.68);
  }

  .site-footer__meta a {
    color: var(--brand-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__newsletter button:hover,
  .site-footer__newsletter button:focus-visible {
    background: var(--brand-cobalt);
    color: var(--brand-white);
  }

  .site-footer__payments {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .site-footer__payments svg {
    width: 2rem;
    height: 1.25rem;
    filter: brightness(0) invert(1);
  }

  @media (max-width: 820px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .site-footer__meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar ícones de pagamento",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Exibir cadastro de novidades",
      "default": false
    }
  ]
}
{% endschema %}
