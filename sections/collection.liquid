{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% assign collection_background_class = '' %}
{% case collection.handle %}
  {% when 'all', 'home', 'personal', 'office', 'play', 'casa-organizacao', 'gadgets-acessorios', 'fidgets-diversao' %}
    {% assign collection_background_class = 'collection-page-section--white' %}
{% endcase %}

<div class="collection-page-section {{ collection_background_class }}">
  <div class="collection-page page-width">
    <header class="collection-page__intro">
      <p class="collection-page__eyebrow">{{ 'collections.kicker' | t }}</p>
      <h1 class="collection-page__heading">
        {% if collection.handle == 'all' %}
          {{ 'collections.title' | t }}
        {% else %}
          {{ collection.title | escape }}
        {% endif %}
      </h1>
      {% if collection.description != blank %}
        <div class="collection-page__description">{{ collection.description }}</div>
      {% endif %}
    </header>

    {%- assign filter_handles = 'casa-organizacao,gadgets-acessorios,fidgets-diversao' | split: ',' -%}
    <nav class="collection-filter" aria-label="{{ 'collections.filter.label' | t }}">
      <ul class="collection-filter__list">
        <li>
          <a
            class="collection-filter__link"
            href="{{ routes.all_products_collection_url }}"
            {% if collection.handle == 'all' %}aria-current="page"{% endif %}
          >
            {{ 'collections.filter.all' | t }}
          </a>
        </li>
        {%- for filter_handle in filter_handles -%}
          {%- assign filter_collection = collections[filter_handle] -%}
          {%- if filter_collection != blank and filter_collection.title != blank -%}
            <li>
              <a
                class="collection-filter__link"
                href="{{ filter_collection.url }}"
                {% if collection.handle == filter_handle %}aria-current="page"{% endif %}
              >
                {{ filter_collection.title | escape }}
                <span class="collection-filter__count">{{ filter_collection.all_products_count }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    {% paginate collection.products by 20 %}
      <div class="collection-products">
        {% for product in collection.products %}
          {% assign product_image = product.featured_image | default: product.images.first %}
          <article class="collection-product">
            {% if product_image %}
              <a class="collection-product__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {{ product_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'collection-product__image-element',
                    alt: product_image.alt | default: product.title,
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 1200px) 25vw, (min-width: 640px) 33vw, 50vw'
                }}
              </a>
            {% else %}
              <a class="collection-product__image collection-product__image--placeholder" href="{{ product.url }}">
                {{ 'collections.no_image' | t }}
              </a>
            {% endif %}
            <div class="collection-product__content">
              <div class="collection-product__badges">
                {% if product.compare_at_price > product.price %}
                  <span class="collection-product__badge">{{ 'collections.promo' | t }}</span>
                {% endif %}
                {% unless product.available %}
                  <span class="collection-product__badge collection-product__badge--sold-out">{{ 'products.sold_out' | t }}</span>
                {% endunless %}
              </div>
              <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
              <div class="collection-product__pricing">
                <span class="collection-product__price">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="collection-product__compare-price">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% else %}
          <div class="collection-empty">
            <h2>{{ 'collections.empty_title' | t }}</h2>
            <p>{{ 'collections.empty_text' | t }}</p>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="collection-pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .collection-page-section--white {
    background: var(--brand-white);
  }

  .collection-page {
    padding-block: var(--section-space);
  }

  .collection-page__intro {
    max-width: 58rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--brand-charcoal);
  }

  .collection-page__eyebrow {
    margin-bottom: 1rem;
    color: var(--brand-cobalt);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .collection-page__heading {
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    font-weight: 700;
    letter-spacing: -0.095em;
    line-height: 0.84;
    color: var(--brand-charcoal);
  }

  .collection-page__description {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: var(--brand-muted);
    line-height: 1.65;
  }

  .collection-filter {
    margin: -0.5rem 0 clamp(1.5rem, 3vw, 2.25rem);
  }

  .collection-filter__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-filter__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--brand-charcoal);
    background: transparent;
    color: var(--brand-charcoal);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .collection-filter__link:hover,
  .collection-filter__link:focus-visible,
  .collection-filter__link[aria-current='page'] {
    border-color: var(--brand-cobalt);
    background: var(--brand-cobalt);
    color: var(--brand-white);
  }

  .collection-filter__count {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  @media (max-width: 639px) {
    .collection-filter__list {
      flex-wrap: nowrap;
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .collection-filter__link {
      flex: none;
      white-space: nowrap;
    }
  }

  .collection-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--brand-border);
    background: var(--brand-border);
  }

  .collection-product {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    padding: 0.75rem;
    border: 0;
    border-radius: 0;
    background: var(--brand-canvas);
    box-shadow: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .collection-product:hover,
  .collection-product:focus-within {
    background: var(--brand-white);
    transform: translateY(-2px);
  }

  .collection-page-section--white .collection-product {
    background: var(--brand-white);
  }

  .collection-product__image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 0.96;
    border-radius: 0;
    overflow: hidden;
    background: var(--brand-pale-blue);
  }

  .collection-product__image-element {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .collection-product:hover .collection-product__image-element,
  .collection-product:focus-within .collection-product__image-element {
    transform: scale(1.03);
  }

  .collection-product__image--placeholder {
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--brand-muted);
    text-align: center;
    font-size: 0.85rem;
  }

  .collection-product__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 5.2rem;
    padding: 0.75rem 0.2rem 0.15rem;
  }

  .collection-product__badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-height: 1.3rem;
    margin-bottom: 0.35rem;
  }

  .collection-product__badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.2rem 0.45rem;
    border-radius: 0;
    background: var(--brand-cobalt);
    color: var(--brand-white);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .collection-product__badge--sold-out {
    background: var(--brand-border);
  }

  .collection-product__content h2 {
    display: -webkit-box;
    min-height: 2.7em;
    margin: 0 0 0.45rem;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: clamp(0.82rem, 0.95vw, 0.96rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .collection-product__pricing {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .collection-product__price {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .collection-product__compare-price {
    color: var(--brand-muted);
    font-size: 0.78rem;
    text-decoration: line-through;
  }

  .collection-empty {
    grid-column: 1 / -1;
    padding: 2.5rem 1.25rem;
    border: 1px dashed var(--brand-border);
    border-radius: 0;
    text-align: center;
    background: var(--brand-white);
  }

  .collection-empty h2 {
    margin-bottom: 0.5rem;
  }

  .collection-empty p {
    color: var(--brand-muted);
  }

  .collection-pagination {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .collection-pagination .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .collection-pagination .pagination a,
  .collection-pagination .pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    min-height: 2.1rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--brand-border);
    border-radius: 0;
    background: var(--brand-white);
  }

  .collection-pagination .pagination .current {
    border-color: var(--brand-cobalt);
    background: var(--brand-cobalt);
    color: var(--brand-white);
  }

  @media (max-width: 959px) {
    .collection-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .collection-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .collection-product {
      padding: 0.5rem;
    }

    .collection-product__content {
      min-height: 4.7rem;
      padding-top: 0.45rem;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Coleção de produtos",
  "settings": []
}
{% endschema %}
