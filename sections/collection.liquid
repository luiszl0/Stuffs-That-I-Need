{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection-page">
  <h1 class="collection-page__heading">
    {% if collection.handle == 'all' %}
      {{ 'collections.title' | t }}
    {% else %}
      {{ collection.title | escape }}
    {% endif %}
  </h1>

  {% paginate collection.products by 20 %}
    <div class="collection-products">
      {% for product in collection.products %}
        <article class="collection-product">
          {% if product.featured_image %}
            <a class="collection-product__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {{ product.featured_image
                | image_url: width: 900
                | image_tag:
                  class: 'collection-product__image-element',
                  alt: product.featured_image.alt | default: product.title,
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 960px) 25vw, (min-width: 640px) 33vw, 50vw',
                  loading: 'lazy'
              }}
            </a>
          {% else %}
            <a class="collection-product__image collection-product__image--placeholder" href="{{ product.url }}">
              {{ 'home.products.empty_state' | t }}
            </a>
          {% endif %}
          <div class="collection-product__content">
            {% if product.compare_at_price > product.price %}
              <span class="collection-product__badge">{{ 'home.products.promo' | t }}</span>
            {% endif %}
            <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
            <div class="collection-product__pricing">
              <span class="collection-product__price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="collection-product__compare-price">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </article>
      {% else %}
        <div class="collection-empty">
          <h2>{{ 'home.products.empty_title' | t }}</h2>
          <p>{{ 'home.products.empty_text' | t }}</p>
        </div>
      {% endfor %}
    </div>

    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection-page {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 5vw, 4rem);
  }

  .collection-page__heading {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.015em;
    text-transform: uppercase;
  }

  .collection-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.65rem, 1.25vw, 1rem);
  }

  .collection-product {
    min-width: 0;
    overflow: hidden;
    padding: 0.45rem;
    border: 1px solid var(--brand-border);
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.48);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .collection-product:hover,
  .collection-product:focus-within {
    border-color: #c8c1b4;
    box-shadow: 0 0.5rem 1.25rem var(--brand-shadow);
    transform: translateY(-2px);
  }

  .collection-product__image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0.55rem;
    overflow: hidden;
    background: #efece6;
  }

  .collection-product__image-element {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-product__image--placeholder {
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--brand-muted);
    text-align: center;
    font-size: 0.85rem;
  }

  .collection-product__content {
    display: flex;
    flex-direction: column;
    min-height: 5.2rem;
    padding: 0.55rem 0.15rem 0.25rem;
  }

  .collection-product__badge {
    align-self: flex-start;
    margin-bottom: 0.2rem;
    color: var(--brand-muted);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .collection-product__content h2 {
    display: -webkit-box;
    min-height: 2.7em;
    margin: 0 0 0.35rem;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: clamp(0.78rem, 0.95vw, 0.9rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .collection-product__pricing {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .collection-product__price {
    font-size: 0.9rem;
    font-weight: 700;
  }

  .collection-product__compare-price {
    color: var(--brand-muted);
    font-size: 0.78rem;
    text-decoration: line-through;
  }

  .collection-empty {
    grid-column: 1 / -1;
    padding: 2.5rem 1.25rem;
    border: 1px dashed var(--brand-border);
    border-radius: 0.85rem;
    text-align: center;
  }

  .collection-empty h2 {
    margin-bottom: 0.5rem;
  }

  .collection-empty p {
    color: var(--brand-muted);
  }

  @media (max-width: 959px) {
    .collection-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .collection-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .collection-product {
      padding: 0.35rem;
      border-radius: 0.7rem;
    }

    .collection-product__content {
      min-height: 4.7rem;
      padding-top: 0.45rem;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
