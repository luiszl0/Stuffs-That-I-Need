{% comment %}
  Product detail section using Shopify's native product media and variant data.
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign gallery_media = product.media %}
{% if gallery_media == blank %}
  {% assign gallery_media = product.images %}
{% endif %}

{% assign featured_media = current_variant.featured_media | default: product.featured_media %}
{% assign initial_media = featured_media | default: gallery_media.first %}

<div class="product-page page-width">
  <nav class="product-breadcrumbs" aria-label="{{ 'products.breadcrumbs' | t }}">
    <a href="{{ routes.root_url }}">{{ shop.name }}</a>
    <span aria-hidden="true">/</span>
    {% if product.collections.size > 0 %}
      {% if product.collections.first.handle == 'frontpage' %}
        <a href="{{ routes.root_url }}">{{ 'home.nav.home' | t }}</a>
      {% else %}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      {% endif %}
      <span aria-hidden="true">/</span>
    {% endif %}
    <span>{{ product.title }}</span>
  </nav>

  <div class="product-page__grid">
    <div class="product-gallery" data-product-gallery>
      {% if gallery_media.size > 0 %}
        <div class="product-gallery__main" aria-live="polite">
          {% for media in gallery_media %}
            <div
              class="product-gallery__slide{% if initial_media and media.id == initial_media.id %} is-active{% endif %}"
              data-media-id="{{ media.id }}"
              aria-hidden="{% if initial_media and media.id == initial_media.id %}false{% else %}true{% endif %}"
            >
              {% case media.media_type %}
                {% when 'image' %}
                  {{ media | image_url: width: 1800 | image_tag: class: 'product-gallery__image', alt: media.alt | default: product.title, loading: 'eager', draggable: false }}
                {% when 'video', 'external_video' %}
                  {{ media | media_tag: image_size: 'master', controls: true, autoplay: false }}
                {% when 'model' %}
                  {{ media | media_tag: image_size: 'master', controls: true }}
                {% else %}
                  {{ media | image_url: width: 1800 | image_tag: class: 'product-gallery__image', alt: media.alt | default: product.title }}
              {% endcase %}
            </div>
          {% endfor %}
        </div>

        {% if gallery_media.size > 1 %}
          <div class="product-gallery__thumbs" role="tablist" aria-label="{{ 'products.gallery' | t }}">
            {% for media in gallery_media %}
              <button
                type="button"
                class="product-gallery__thumb{% if initial_media and media.id == initial_media.id %} is-selected{% endif %}"
                data-target-media-id="{{ media.id }}"
                aria-label="{{ media.alt | default: product.title }}"
                aria-pressed="{% if initial_media and media.id == initial_media.id %}true{% else %}false{% endif %}"
              >
                {% if media.media_type == 'image' %}
                  {{ media | image_url: width: 260 | image_tag: class: 'product-gallery__thumb-image', alt: media.alt | default: product.title, loading: 'lazy' }}
                {% else %}
                  <span class="product-gallery__thumb-fallback">{{ media.media_type | replace: '_', ' ' | capitalize }}</span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="product-gallery__placeholder">
          <span>{{ 'products.no_media' | t }}</span>
        </div>
      {% endif %}
    </div>

    <div class="product-summary">
      <div class="product-summary__meta">
        {% if product.vendor != blank %}
          <p class="product-summary__vendor">{{ product.vendor }}</p>
        {% endif %}
      </div>

      <h1>{{ product.title }}</h1>

      <div class="product-price-block" data-product-price-block>
        <span class="product-price" data-product-price>
          {{ current_variant.price | money }}
        </span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="product-price product-price--compare" data-product-compare-price>
            {{ current_variant.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      <p class="product-availability" data-product-availability>
        {% if current_variant.available %}
          {{ 'products.in_stock' | t }}
        {% else %}
          {{ 'products.out_of_stock' | t }}
        {% endif %}
      </p>

      {% form 'product', product, class: 'product-form', data-product-form: product.id %}
        {% if product.variants.size > 1 %}
          {% for option in product.options_with_values %}
            <div class="product-form__option">
              <label for="product-option-{{ forloop.index0 }}-{{ section.id }}">{{ option.name }}</label>
              <select
                id="product-option-{{ forloop.index0 }}-{{ section.id }}"
                name="{{ option.name | handleize }}"
                class="product-form__select"
                data-product-option
              >
                {% for value in option.values %}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        {% endif %}

        <select name="id" class="product-form__variant-select" data-product-variant-select>
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-price="{{ variant.price | money }}"
              data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% else %}{{ '' }}{% endif %}"
              data-media-id="{{ variant.featured_media.id | default: product.featured_media.id | default: '' }}"
              data-available="{{ variant.available }}"
              {% if variant.id == current_variant.id %}
                selected
              {% endif %}
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              {{ variant.title }}
            </option>
          {% endfor %}
        </select>

        <div class="product-form__purchase">
          <label class="product-form__quantity" for="product-quantity-{{ section.id }}">
            <span>{{ 'products.quantity' | t }}</span>
            <input id="product-quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
          </label>

          <button type="submit" class="button button--primary product-form__submit" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}
              {{ 'products.add_to_cart' | t }}
            {% else %}
              {{ 'products.sold_out' | t }}
            {% endif %}
          </button>
        </div>
      {% endform %}

      {% if product.description != blank %}
        <div class="product-description">
          <h2>{{ 'products.description' | t }}</h2>
          <div>{{ product.description }}</div>
        </div>
      {% endif %}

      {% if product.metafields.custom.benefits != blank %}
        <div class="product-benefits">
          <h2>{{ 'products.benefits' | t }}</h2>
          <ul>
            {% for item in product.metafields.custom.benefits.value %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <div class="product-policy">
        {% if shop.shipping_policy %}
          <p><strong>{{ 'products.shipping' | t }}</strong> <a href="{{ shop.shipping_policy.url }}">{{ 'policies.shipping' | t }}</a></p>
        {% endif %}
        {% if shop.refund_policy %}
          <p><strong>{{ 'products.returns' | t }}</strong> <a href="{{ shop.refund_policy.url }}">{{ 'policies.returns' | t }}</a></p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const gallery = document.querySelector('[data-product-gallery]');
    const variantSelect = document.querySelector('[data-product-variant-select]');

    if (gallery) {
      const slides = gallery.querySelectorAll('.product-gallery__slide');
      const thumbs = gallery.querySelectorAll('.product-gallery__thumb');

      const updateGallery = function (mediaId) {
        slides.forEach(function (slide) {
          const isActive = slide.dataset.mediaId === mediaId;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });

        thumbs.forEach(function (thumb) {
          const isSelected = thumb.dataset.targetMediaId === mediaId;
          thumb.classList.toggle('is-selected', isSelected);
          thumb.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        });
      };

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          updateGallery(thumb.dataset.targetMediaId);
        });
      });
    }

    if (variantSelect) {
      const priceNode = document.querySelector('[data-product-price]');
      const comparePriceNode = document.querySelector('[data-product-compare-price]');
      const availabilityNode = document.querySelector('[data-product-availability]');
      const submitButton = document.querySelector('.product-form__submit');

      const updateVariantState = function () {
        const selectedOption = variantSelect.options[variantSelect.selectedIndex];
        if (!selectedOption) return;

        const selectedMediaId = selectedOption.dataset.mediaId;
        const priceValue = selectedOption.dataset.price;
        const comparePriceValue = selectedOption.dataset.comparePrice;
        const isAvailable = selectedOption.dataset.available === 'true';

        if (priceNode) {
          priceNode.textContent = priceValue || priceNode.textContent;
        }

        if (comparePriceNode) {
          if (comparePriceValue) {
            comparePriceNode.textContent = comparePriceValue;
            comparePriceNode.style.display = 'inline';
          } else {
            comparePriceNode.textContent = '';
            comparePriceNode.style.display = 'none';
          }
        }

        if (availabilityNode) {
          availabilityNode.textContent = isAvailable ? 'Em estoque' : 'Esgotado';
        }

        if (submitButton) {
          submitButton.disabled = !isAvailable;
          submitButton.textContent = isAvailable ? 'Adicionar ao carrinho' : 'Esgotado';
        }

        if (selectedMediaId && selectedMediaId !== '' && gallery) {
          const galleryMediaId = String(selectedMediaId);
          const slide = gallery.querySelector('[data-media-id="' + galleryMediaId + '"]');
          if (slide) {
            const slides = gallery.querySelectorAll('.product-gallery__slide');
            slides.forEach(function (item) {
              const isActive = item.dataset.mediaId === galleryMediaId;
              item.classList.toggle('is-active', isActive);
              item.setAttribute('aria-hidden', isActive ? 'false' : 'true');
            });

            const thumbs = gallery.querySelectorAll('.product-gallery__thumb');
            thumbs.forEach(function (thumb) {
              const isSelected = thumb.dataset.targetMediaId === galleryMediaId;
              thumb.classList.toggle('is-selected', isSelected);
              thumb.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
            });
          }
        }
      };

      variantSelect.addEventListener('change', updateVariantState);
      updateVariantState();
    }
  });
{% endjavascript %}

{% stylesheet %}
  .product-page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .product-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-muted);
  }

  .product-breadcrumbs a {
    color: var(--brand-charcoal);
  }

  .product-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(1.5rem, 3vw, 2.8rem);
    align-items: start;
  }

  .product-gallery {
    display: grid;
    gap: 1rem;
  }

  .product-gallery__main {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    max-height: 36rem;
    border: 1px solid rgba(36, 36, 36, 0.08);
    border-radius: 1.75rem;
    background: #FFFFFF;
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(36, 36, 36, 0.05);
  }

  .product-gallery__slide {
    display: none;
    width: 100%;
    height: 100%;
    min-height: 0;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
  }

  .product-gallery__slide.is-active {
    display: flex;
  }

  .product-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #FFFFFF;
  }

  .product-gallery__slide video,
  .product-gallery__slide model-viewer {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: #FFFFFF;
  }

  .product-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(4.5rem, 1fr));
    gap: 0.75rem;
  }

  .product-gallery__thumb {
    border: 1px solid rgba(36, 36, 36, 0.08);
    border-radius: 1rem;
    background: #FFFFFF;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    aspect-ratio: 1;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-gallery__thumb:hover,
  .product-gallery__thumb:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(36, 36, 36, 0.06);
  }

  .product-gallery__thumb.is-selected {
    border-color: var(--brand-cobalt);
    box-shadow: 0 8px 18px rgba(36, 36, 36, 0.08);
  }

  .product-gallery__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__thumb-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-muted);
    background: #F7F7F7;
  }

  .product-gallery__placeholder {
    min-height: 22rem;
    display: grid;
    place-items: center;
    border: 1px dashed var(--brand-border);
    border-radius: 1.75rem;
    background: #FFFFFF;
    color: var(--brand-muted);
  }

  .product-summary {
    display: grid;
    gap: 1.4rem;
    align-content: start;
    padding: clamp(1rem, 2vw, 1.6rem);
    border: 1px solid rgba(36, 36, 36, 0.08);
    border-radius: 1.5rem;
    background: #FFFFFF;
    box-shadow: 0 10px 28px rgba(36, 36, 36, 0.02);
  }

  .product-summary__vendor {
    margin: 0;
    color: var(--brand-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .product-summary h1 {
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 0.94;
    letter-spacing: -0.07em;
    margin: 0;
  }

  .product-price-block {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.7rem;
    padding: 0.7rem 0.9rem;
    border-radius: 1rem;
    background: #F7F7F7;
    width: fit-content;
  }

  .product-price {
    font-size: clamp(1.5rem, 2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .product-price--compare {
    color: var(--brand-muted);
    text-decoration: line-through;
    font-size: 1rem;
    font-weight: 500;
  }

  .product-availability {
    margin: 0;
    color: var(--brand-muted);
    font-size: 0.96rem;
  }

  .product-form {
    display: grid;
    gap: 1.1rem;
  }

  .product-form__option {
    display: grid;
    gap: 0.5rem;
  }

  .product-form__option label,
  .product-form__quantity span {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-muted);
  }

  .product-form__select,
  .product-form__variant-select,
  .product-form__quantity input {
    width: 100%;
    min-height: 3.1rem;
    border: 1px solid rgba(36, 36, 36, 0.1);
    border-radius: 0.9rem;
    background: #FFFFFF;
    padding: 0.8rem 1rem;
    color: var(--brand-charcoal);
  }

  .product-form__purchase {
    display: grid;
    grid-template-columns: minmax(0, 0.25fr) minmax(0, 1fr);
    gap: 0.8rem;
    align-items: end;
  }

  .product-form__quantity {
    display: grid;
    gap: 0.5rem;
  }

  .product-form__submit {
    width: 100%;
    margin-top: 1.7rem;
    border: 0;
    cursor: pointer;
    box-shadow: 0 14px 24px rgba(36, 36, 36, 0.1);
  }

  .product-form__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .product-description,
  .product-benefits,
  .product-policy {
    border-top: 1px solid var(--brand-border);
    padding-top: 1.4rem;
  }

  .product-description h2,
  .product-benefits h2 {
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .product-description div,
  .product-policy p,
  .product-benefits li {
    color: var(--brand-muted);
    line-height: 1.7;
  }

  .product-benefits ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.55rem;
  }

  .product-policy {
    display: grid;
    gap: 0.5rem;
  }

  .product-policy p {
    margin: 0;
  }

  @media (max-width: 820px) {
    .product-page__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .product-gallery__main,
    .product-gallery__slide {
      min-height: 0;
    }

    .product-gallery__main {
      max-height: min(34rem, 90vw);
    }

    .product-form__purchase {
      grid-template-columns: 1fr;
    }
  }

  .product-page {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .product-breadcrumbs {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }

  .product-breadcrumbs a:hover {
    color: var(--brand-cobalt);
  }

  .product-page__grid {
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .product-gallery__main,
  .product-gallery__slide,
  .product-gallery__thumb,
  .product-summary {
    border-radius: 0;
    box-shadow: none;
  }

  .product-gallery__main {
    border: 0;
    background: var(--brand-pale-blue);
  }

  .product-gallery__slide,
  .product-gallery__image,
  .product-gallery__slide video,
  .product-gallery__slide model-viewer {
    background: var(--brand-pale-blue);
  }

  .product-gallery__image {
    object-fit: contain;
  }

  .product-gallery__thumb {
    border-radius: 0;
    background: var(--brand-white);
  }

  .product-gallery__thumb.is-selected {
    border: 2px solid var(--brand-cobalt);
  }

  .product-gallery__placeholder {
    border: 0;
    border-radius: 0;
    background: var(--brand-cobalt);
    color: var(--brand-white);
  }

  .product-summary {
    position: sticky;
    top: 7rem;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2.5rem) 0;
    border: 0;
    border-top: 1px solid var(--brand-charcoal);
    border-radius: 0;
    background: transparent;
  }

  .product-summary__vendor {
    color: var(--brand-cobalt);
    font-weight: 700;
  }

  .product-summary h1 {
    max-width: 12ch;
    font-size: clamp(2.8rem, 5.3vw, 5rem);
    letter-spacing: -0.09em;
    line-height: 0.87;
  }

  .product-price-block {
    gap: 0.8rem;
    padding: 0;
    border-radius: 0;
    background: transparent;
  }

  .product-price {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    letter-spacing: -0.07em;
  }

  .product-form__select,
  .product-form__variant-select,
  .product-form__quantity input {
    border-color: var(--brand-border);
    border-radius: 0;
    background: var(--brand-white);
  }

  .product-form__submit {
    border: 1px solid var(--brand-cobalt);
    border-radius: 0;
    background: var(--brand-cobalt);
    color: var(--brand-white);
    box-shadow: none;
  }

  .product-form__submit:hover:not(:disabled) {
    border-color: var(--brand-charcoal);
    background: var(--brand-charcoal);
  }

  .product-description,
  .product-benefits,
  .product-policy {
    border-color: var(--brand-border);
  }

  .product-description h2,
  .product-benefits h2 {
    color: var(--brand-cobalt);
  }

  .product-policy a {
    color: var(--brand-cobalt);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 820px) {
    .product-page__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .product-summary {
      position: static;
      padding: 1.5rem 0 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
