{%- assign reasons = product.metafields.custom.why_choose.value -%}
{%- if reasons.size > 0 -%}
  {%- assign heading = section.settings.heading -%}
  {%- if heading == blank -%}
    {%- assign heading = 'product_page.why.heading' | t -%}
  {%- endif -%}
  {%- assign side_image = product.images[1] | default: product.featured_image -%}
  <section class="pp-section pp-why">
    <div class="page-width pp-why__layout">
      {% if side_image %}
        <div class="pp-why__media">
          {{ side_image | image_url: width: 1000 | image_tag:
            alt: side_image.alt | default: product.title,
            widths: '400, 600, 800, 1000',
            sizes: '(min-width: 821px) 45vw, 100vw',
            loading: 'lazy'
          }}
        </div>
      {% endif %}
      <div class="pp-why__content">
        {%- assign heading_eyebrow = 'product_page.why.eyebrow' | t -%}
        {% render 'product-section-heading', eyebrow: heading_eyebrow, heading: heading %}
        <ul class="pp-why__list">
          {% for reason in reasons limit: 6 %}
            <li>
              {% render 'icon', name: 'check', size: 20 %}
              <div>{% render 'product-labeled-item', item: reason %}</div>
            </li>
          {% endfor %}
        </ul>
        <a class="button button--primary" href="#product-buy">{{ 'product_page.cta.back_to_purchase' | t }}</a>
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .pp-why__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .pp-why__media {
    background: var(--brand-pale-blue);
  }
  .pp-why__media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .pp-why__content {
    display: grid;
    justify-items: start;
  }
  .pp-why__content .pp-heading {
    margin-bottom: 1.5rem;
  }
  .pp-why__list {
    display: grid;
    width: 100%;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--brand-charcoal);
  }
  .pp-why__list li {
    display: flex;
    gap: 0.9rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--brand-border);
    color: var(--brand-cobalt);
  }
  .pp-why__list li > div {
    display: grid;
    gap: 0.2rem;
    color: var(--brand-charcoal);
  }
  .pp-why__list span {
    color: var(--brand-muted);
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .pp-why__layout {
      grid-template-columns: 1fr;
    }
    .pp-why__media img {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_page.why.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:product_page.settings.metafield_info_why"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "t:product_page.why.name" }]
}
{% endschema %}
