{%- assign spec_lines = product.metafields.custom.specifications.value -%}
{%- assign included_items = product.metafields.custom.included_items.value -%}
{%- assign first_variant = product.variants.first -%}
{%- assign has_specs = false -%}
{%- if spec_lines.size > 0 or included_items.size > 0 or product.type != blank or first_variant.weight > 0 -%}
  {%- assign has_specs = true -%}
{%- endif -%}
{%- unless product.has_only_default_variant -%}
  {%- assign has_specs = true -%}
{%- endunless -%}

{%- if has_specs or product.description != blank -%}
  {%- assign heading = section.settings.heading -%}
  {%- if heading == blank -%}
    {%- assign heading = 'product_page.specs.heading' | t -%}
  {%- endif -%}
  <section class="pp-section pp-specs">
    <div class="page-width">
      {%- assign heading_eyebrow = 'product_page.specs.eyebrow' | t -%}
      {% render 'product-section-heading', eyebrow: heading_eyebrow, heading: heading %}
      <div class="pp-specs__layout">
        {% if product.description != blank %}
          <div class="pp-specs__description">
            <h3>{{ 'products.description' | t }}</h3>
            <div class="pp-specs__rich">{{ product.description }}</div>
          </div>
        {% endif %}

        {% if has_specs %}
          <div class="pp-specs__panel">
            <dl class="pp-specs__list">
              {% if product.type != blank %}
                <div><dt>{{ 'product_page.specs.type' | t }}</dt><dd>{{ product.type }}</dd></div>
              {% endif %}
              {% if product.vendor != blank %}
                <div><dt>{{ 'product_page.specs.brand' | t }}</dt><dd>{{ product.vendor }}</dd></div>
              {% endif %}
              {% unless product.has_only_default_variant %}
                {% for option in product.options_with_values %}
                  <div><dt>{{ option.name }}</dt><dd>{{ option.values | join: ', ' }}</dd></div>
                {% endfor %}
              {% endunless %}
              {% if first_variant.weight > 0 %}
                <div><dt>{{ 'product_page.specs.weight' | t }}</dt><dd>{{ first_variant.weight | weight_with_unit: first_variant.weight_unit }}</dd></div>
              {% endif %}
              {% for line in spec_lines %}
                {%- assign line_parts = line | split: ':' -%}
                {%- if line_parts.size > 1 -%}
                  {%- assign line_label = line_parts.first | strip -%}
                  {%- assign line_value = line | remove_first: line_parts.first | remove_first: ':' | strip -%}
                  <div><dt>{{ line_label }}</dt><dd>{{ line_value }}</dd></div>
                {%- else -%}
                  <div><dt>{{ line | strip }}</dt><dd>&nbsp;</dd></div>
                {%- endif -%}
              {% endfor %}
            </dl>

            {% if included_items.size > 0 %}
              <div class="pp-specs__included">
                <h3>{% render 'icon', name: 'box', size: 20 %} {{ 'product_page.specs.included' | t }}</h3>
                <ul>
                  {% for item in included_items %}
                    <li>{% render 'icon', name: 'check', size: 16 %}<span>{{ item }}</span></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .pp-specs__layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .pp-specs__description {
    max-width: 48rem;
  }
  .pp-specs__description h3,
  .pp-specs__included h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    color: var(--brand-cobalt);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pp-specs__rich {
    color: var(--brand-muted);
    line-height: 1.8;
  }
  .pp-specs__rich > :first-child {
    margin-top: 0;
  }
  .pp-specs__panel {
    display: grid;
    gap: 2rem;
  }
  .pp-specs__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--brand-border);
    background: var(--brand-border);
  }
  .pp-specs__list > div {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.25rem 1.4rem;
    background: var(--brand-white);
    border-top: 3px solid var(--brand-cobalt);
  }
  .pp-specs__list dt {
    color: var(--brand-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pp-specs__list dd {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--brand-charcoal);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .pp-specs__included {
    padding: 1.5rem;
    background: var(--brand-pale-blue);
  }
  .pp-specs__included ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.6rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pp-specs__included li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .pp-specs__included li .icon {
    margin-top: 0.2rem;
    color: var(--brand-cobalt);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_page.specs.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:product_page.settings.metafield_info_specs"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "t:product_page.specs.name" }]
}
{% endschema %}
