{%- assign spec_lines = product.metafields.custom.specifications.value -%}
{%- assign included_items = product.metafields.custom.included_items.value -%}
{%- assign first_variant = product.variants.first -%}
{%- assign has_specs = false -%}
{%- if spec_lines.size > 0 or included_items.size > 0 or product.type != blank or first_variant.weight > 0 -%}
  {%- assign has_specs = true -%}
{%- endif -%}
{%- unless product.has_only_default_variant -%}
  {%- assign has_specs = true -%}
{%- endunless -%}

{%- if has_specs or product.description != blank -%}
  {%- assign heading = section.settings.heading -%}
  {%- if heading == blank -%}
    {%- assign heading = 'product_page.specs.heading' | t -%}
  {%- endif -%}
  <section class="pp-section pp-specs">
    <div class="page-width">
      {%- assign heading_eyebrow = 'product_page.specs.eyebrow' | t -%}
      {% render 'product-section-heading', eyebrow: heading_eyebrow, heading: heading %}
      <div class="pp-specs__layout{% if has_specs and product.description != blank %} pp-specs__layout--split{% endif %}">
        {% if has_specs %}
          <div class="pp-specs__col">
            <h3 class="pp-specs__title">{% render 'icon', name: 'ruler', size: 22 %}<span>{{ 'product_page.specs.table_title' | t }}</span></h3>
            <table class="pp-specs__table">
              <tbody>
                {% if product.type != blank %}
                  <tr><th scope="row">{{ 'product_page.specs.type' | t }}</th><td>{{ product.type }}</td></tr>
                {% endif %}
                {% if product.vendor != blank %}
                  <tr><th scope="row">{{ 'product_page.specs.brand' | t }}</th><td>{{ product.vendor }}</td></tr>
                {% endif %}
                {% unless product.has_only_default_variant %}
                  {% for option in product.options_with_values %}
                    {%- assign option_name_key = option.name | downcase | strip -%}
                    {%- if option_name_key == 'ships from' -%}{%- continue -%}{%- endif -%}
                    <tr><th scope="row">{{ option.name }}</th><td>{{ option.values | join: ', ' }}</td></tr>
                  {% endfor %}
                {% endunless %}
                {% if first_variant.weight > 0 %}
                  <tr><th scope="row">{{ 'product_page.specs.weight' | t }}</th><td>{{ first_variant.weight | weight_with_unit: first_variant.weight_unit }}</td></tr>
                {% endif %}
                {% for line in spec_lines %}
                  {%- assign line_parts = line | split: ':' -%}
                  {%- if line_parts.size > 1 -%}
                    {%- assign line_label = line_parts.first | strip -%}
                    {%- assign line_value = line | remove_first: line_parts.first | remove_first: ':' | strip -%}
                    <tr><th scope="row">{{ line_label }}</th><td>{{ line_value }}</td></tr>
                  {%- else -%}
                    <tr><th scope="row" colspan="2">{{ line | strip }}</th></tr>
                  {%- endif -%}
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}

        {% if product.description != blank or included_items.size > 0 %}
          <div class="pp-specs__col">
            {% if product.description != blank %}
              <h3 class="pp-specs__title">{% render 'icon', name: 'star', size: 22 %}<span>{{ 'product_page.specs.highlights_title' | t }}</span></h3>
              <div class="pp-specs__rich">{{ product.description }}</div>
            {% endif %}

            {% if included_items.size > 0 %}
              <div class="pp-specs__included">
                <h3 class="pp-specs__title">{% render 'icon', name: 'box', size: 22 %}<span>{{ 'product_page.specs.included' | t }}</span></h3>
                <ul>
                  {% for item in included_items %}
                    <li>{% render 'icon', name: 'check', size: 18 %}<span>{{ item }}</span></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .pp-specs__layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .pp-specs__layout--split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .pp-specs__col {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  .pp-specs__title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--brand-charcoal);
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .pp-specs__title .icon {
    flex: none;
    color: var(--brand-cobalt);
  }
  .pp-specs__table {
    width: 100%;
    border-collapse: collapse;
  }
  .pp-specs__table th,
  .pp-specs__table td {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--brand-border);
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
  }
  .pp-specs__table th {
    width: 40%;
    padding-right: 1rem;
    color: var(--brand-muted);
    font-size: 1rem;
    font-weight: 500;
  }
  .pp-specs__table td {
    color: var(--brand-charcoal);
    font-size: 1.05rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .pp-specs__rich {
    color: var(--brand-charcoal);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .pp-specs__rich > :first-child {
    margin-top: 0;
  }
  .pp-specs__rich strong,
  .pp-specs__rich b {
    font-weight: 700;
  }
  .pp-specs__rich ul,
  .pp-specs__rich ol {
    padding-left: 1.25rem;
  }
  .pp-specs__included {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--brand-pale-blue);
  }
  .pp-specs__included .pp-specs__title {
    border-bottom-color: var(--brand-cobalt);
  }
  .pp-specs__included ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pp-specs__included li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    color: var(--brand-charcoal);
    font-size: 1.05rem;
    font-weight: 500;
  }
  .pp-specs__included li .icon {
    flex: none;
    margin-top: 0.2rem;
    color: var(--brand-cobalt);
  }
  @media (max-width: 599px) {
    .pp-specs__table th {
      width: 42%;
      font-size: 0.95rem;
    }
    .pp-specs__included {
      padding: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_page.specs.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:product_page.settings.metafield_info_specs"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "t:product_page.specs.name" }]
}
{% endschema %}
