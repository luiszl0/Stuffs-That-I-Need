<div class="announcement-bar">
  <div class="page-width">
    <p>{{ 'home.announcement.message' | t }}</p>
  </div>
</div>

<header class="site-header">
  <div class="site-header__inner page-width">
    <div class="header__brand">
      {{ shop.name | link_to: routes.root_url }}
    </div>

    {% liquid
      assign nav_menu = section.settings.menu
      assign header_links = nil
      if nav_menu != blank
        assign header_links = nav_menu.links
      endif
    %}

    <nav class="header__nav" id="site-navigation" aria-label="{{ 'home.header.navigation' | t }}">
      {% if header_links != blank %}
        {% for link in header_links %}
          {{ link.title | link_to: link.url }}
        {% endfor %}
      {% else %}
        {% assign category_handles = 'home|personal|office|play' | split: '|' %}
        {% for category_handle in category_handles %}
          {% assign category = collections[category_handle] %}
          {% if category != blank %}
            {{ category.title | capitalize | link_to: category.url }}
          {% endif %}
        {% endfor %}
      {% endif %}
    </nav>

    <div class="header__icons">
      <a class="header__icon" href="{{ routes.search_url }}" aria-label="{{ 'search.title' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="10.8" cy="10.8" r="6.8"></circle>
          <path d="m16 16 4.2 4.2"></path>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="header__icon" href="{{ routes.account_url }}" aria-label="{{ 'customers.login.title' | t }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a class="header__icon header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'cart.title' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      {% if localization.available_languages.size > 1 %}
        {% form 'localization', class: 'header__localization' %}
          <select class="header__language-select" id="HeaderLanguage" name="language_code" aria-label="{{ 'localization.language_label' | t }}">
            {% for language in localization.available_languages %}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {% case language.iso_code %}
                  {% when 'pt-BR' %}
                    Português (Brasil)
                  {% when 'en' %}
                    English
                  {% else %}
                    {{ language.endonym_name | escape }}
                {% endcase %}
              </option>
            {% endfor %}
          </select>
        {% endform %}
      {% endif %}

      <button class="header__menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="{{ 'home.header.menu' | t }}">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var menuToggle = document.querySelector('.header__menu-toggle');
    var nav = document.querySelector('.header__nav');
    var languageSelect = document.querySelector('.header__language-select');

    if (menuToggle && nav) {
      menuToggle.addEventListener('click', function () {
        var isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!isExpanded));
        nav.classList.toggle('is-open', !isExpanded);
      });
    }

    if (languageSelect) {
      languageSelect.addEventListener('change', function () {
        languageSelect.form.submit();
      });
    }
  });
{% endjavascript %}

{% stylesheet %}
  .announcement-bar {
    background: var(--brand-cobalt);
    color: var(--brand-white);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .announcement-bar .page-width {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 2rem;
    text-align: center;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(242, 239, 231, 0.96);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--brand-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5.25rem;
  }

  .header__brand {
    font-size: clamp(1.2rem, 1.7vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 1.8vw, 1.65rem);
    flex: 1;
    font-size: 0.69rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  .header__nav a {
    position: relative;
    color: var(--brand-charcoal);
    opacity: 1;
    transition: color 0.2s ease;
  }

  .header__nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.4rem;
    left: 0;
    height: 2px;
    background: var(--brand-cobalt);
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.2s ease;
  }

  .header__nav a:hover,
  .header__nav a:focus-visible {
    color: var(--brand-cobalt);
  }

  .header__nav a:hover::after,
  .header__nav a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .header__localization {
    margin: 0;
  }

  .header__language-select {
    max-width: 10rem;
    min-height: 2.6rem;
    padding: 0.4rem 1.8rem 0.4rem 0.65rem;
    border: 1px solid var(--brand-border);
    border-radius: 0;
    background: transparent;
    color: var(--brand-charcoal);
    font: inherit;
    cursor: pointer;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0;
    position: relative;
    border: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .header__icon:hover,
  .header__icon:focus-visible {
    border-color: var(--brand-cobalt);
    color: var(--brand-cobalt);
  }

  .header__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .header__icon:focus-visible,
  .header__menu-toggle:focus-visible,
  .header__nav a:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 3px;
  }

  .header__cart {
    position: relative;
  }

  .header__cart-count {
    position: absolute;
    top: -0.15rem;
    right: -0.15rem;
    min-width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brand-cobalt);
    color: var(--brand-white);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .header__menu-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--brand-border);
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header__menu-toggle span {
    width: 1.1rem;
    height: 2px;
    border-radius: 999px;
    background: var(--brand-charcoal);
    display: block;
  }

  @media (max-width: 820px) {
    .header__menu-toggle {
      display: flex;
    }

    .site-header__inner {
      position: relative;
      flex-wrap: wrap;
      padding: 0.75rem 0;
    }

    .header__nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 0 1.25rem;
      border-top: 1px solid var(--brand-border);
      gap: 0.25rem;
    }

    .header__nav a {
      width: 100%;
      padding: 0.6rem 0;
      font-family: var(--font-display);
      font-size: 1.35rem;
      letter-spacing: -0.04em;
      text-transform: none;
    }

    .header__nav a::after {
      display: none;
    }

    .header__nav.is-open {
      display: flex;
    }

    .site-header__inner {
      gap: 0.8rem;
    }

    .header__icons {
      gap: 0.35rem;
    }

    .header__language-select {
      max-width: 7.5rem;
      min-height: 2.4rem;
      font-size: 0.78rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
