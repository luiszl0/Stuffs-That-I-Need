<section class="home-categories">
  <div class="page-width">
    <div class="home-categories__heading">
      <p class="home-categories__eyebrow">{{ 'home.categories.kicker' | t }}</p>
      <h2>{{ 'home.categories.title' | t }}</h2>
    </div>

    <div class="category-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign category_handle = blank %}
          {% assign category_title = block.settings.title %}
          {% if category_title == blank %}
            {% case forloop.index %}
              {% when 1 %}
                {% assign category_handle = 'casa' %}
              {% when 2 %}
                {% assign category_handle = 'miniaturas' %}
              {% when 3 %}
                {% assign category_handle = 'diversao' %}
              {% when 4 %}
                {% assign category_handle = 'gadgets' %}
              {% else %}
                {% assign category_title = 'home.categories.misc' | t %}
            {% endcase %}
            {% if category_handle != blank %}
              {% assign category_title_key = category_handle | replace: '-', '_' | prepend: 'home.categories.' %}
              {% assign category_title = category_title_key | t %}
            {% endif %}
          {% endif %}

          {% assign category_url = block.settings.link_url %}
          {% if category_url == blank %}
            {% if block.settings.collection != blank %}
              {% assign category_url = block.settings.collection.url %}
            {% elsif category_handle != blank %}
              {% assign category_collection = collections[category_handle] %}
              {% if category_collection != blank %}
                {% assign category_url = category_collection.url %}
              {% else %}
                {% assign category_url = routes.collections_url | append: '/' | append: category_handle %}
              {% endif %}
            {% else %}
              {% assign category_url = routes.all_products_collection_url %}
            {% endif %}
          {% endif %}

          <a class="category-card" href="{{ category_url }}" {{ block.shopify_attributes }}>
            <div class="category-card__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: class: 'category-card__image', alt: block.settings.image.alt | default: category_title }}
              {% else %}
                <div class="category-card__placeholder"></div>
              {% endif %}
            </div>

            <div class="category-card__body">
              <span class="category-card__symbol" aria-hidden="true">
                {% case forloop.index %}
                  {% when 1 %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5 14.7 9l6.8 3-6.8 2.8-2.7 6.7-2.8-6.7L2.5 12l6.7-3L12 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="19" cy="5" r="1.5" fill="currentColor"/></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m3 10 9-7 9 7v10.5H3V10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 20.5v-7h6v7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m3 15 2-6h12l4 6v4H3v-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5 9l2-3h8l2 3M6.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM17.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m19 2 .8 2.2L22 5l-2.2.8L19 8l-.8-2.2L16 5l2.2-.8L19 2Z" fill="currentColor"/></svg>
                {% endcase %}
              </span>
              <h3>{{ category_title }}</h3>
              <span class="category-card__explore">{{ 'home.categories.explore' | t }}</span>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% assign fallback_handles = 'casa|miniaturas|diversao|gadgets' | split: '|' %}
        {% for fallback_handle in fallback_handles %}
          {% assign fallback_collection = collections[fallback_handle] %}
          {% assign fallback_title_key = fallback_handle | replace: '-', '_' | prepend: 'home.categories.' %}
          {% if fallback_collection != blank %}
            {% assign fallback_url = fallback_collection.url %}
          {% else %}
            {% assign fallback_url = routes.collections_url | append: '/' | append: fallback_handle %}
          {% endif %}
          <a class="category-card" href="{{ fallback_url }}">
            <div class="category-card__media">
              <div class="category-card__placeholder"></div>
            </div>
            <div class="category-card__body">
              <span class="category-card__symbol" aria-hidden="true">
                {% case forloop.index %}
                  {% when 1 %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5 14.7 9l6.8 3-6.8 2.8-2.7 6.7-2.8-6.7L2.5 12l6.7-3L12 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="19" cy="5" r="1.5" fill="currentColor"/></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m3 10 9-7 9 7v10.5H3V10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 20.5v-7h6v7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m3 15 2-6h12l4 6v4H3v-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5 9l2-3h8l2 3M6.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM17.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m19 2 .8 2.2L22 5l-2.2.8L19 8l-.8-2.2L16 5l2.2-.8L19 2Z" fill="currentColor"/></svg>
                {% endcase %}
              </span>
              <h3>{{ fallback_title_key | t }}</h3>
              <span class="category-card__explore">{{ 'home.categories.explore' | t }}</span>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .home-categories {
    padding: clamp(3rem, 5vw, 4.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-categories__heading {
    max-width: 52rem;
    margin-bottom: 1.5rem;
  }

  .home-categories__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-muted);
    margin-bottom: 0.75rem;
  }

  .home-categories__heading h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .category-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    min-height: 8rem;
    border: 1px solid var(--brand-border);
    border-radius: 1rem;
    overflow: hidden;
    background: linear-gradient(120deg, rgba(216, 240, 106, 0.18), rgba(168, 199, 255, 0.18));
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .category-card:hover,
  .category-card:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(36, 36, 36, 0.22);
  }

  .category-card__media {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    min-height: 8rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.3);
  }

  .category-card__image,
  .category-card__placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  .category-card__image {
    object-fit: cover;
  }

  .category-card__placeholder {
    background:
      radial-gradient(circle at 70% 35%, rgba(255, 255, 255, 0.7), transparent 34%),
      linear-gradient(135deg, rgba(168, 199, 255, 0.42), rgba(255, 182, 159, 0.38));
  }

  .category-card__body {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: 0.45rem 0.6rem;
    padding: 0.85rem 0.8rem;
  }

  .category-card__symbol {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 0.55rem;
    color: var(--brand-charcoal);
    background: rgba(216, 240, 106, 0.7);
  }

  .category-card__symbol svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .category-card__body h3 {
    min-width: 0;
    font-size: clamp(0.76rem, 1vw, 0.95rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .category-card__explore {
    display: inline-flex;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-muted);
  }

  @media (max-width: 980px) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .category-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
      min-height: 7rem;
    }

    .category-card__media {
      min-height: 7rem;
    }

    .category-card__body {
      gap: 0.4rem;
      padding: 0.7rem 0.6rem;
    }

    .category-card__symbol {
      width: 1.4rem;
      height: 1.4rem;
    }

    .category-card__symbol svg {
      width: 1rem;
      height: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category discovery",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Custom destination URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category discovery",
      "category": "Homepage",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
