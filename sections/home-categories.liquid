<section class="home-categories">
  <div class="page-width">
    <div class="home-categories__heading">
      <p class="home-categories__eyebrow">{{ 'home.categories.kicker' | t }}</p>
      <h2>{{ 'home.categories.title' | t }}</h2>
    </div>

    <div class="category-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign category_handle = blank %}
          {% assign category_title = block.settings.title %}
          {% if category_title == blank %}
            {% case forloop.index %}
              {% when 1 %}
                {% assign category_handle = 'home' %}
              {% when 2 %}
                {% assign category_handle = 'personal' %}
              {% when 3 %}
                {% assign category_handle = 'office' %}
              {% when 4 %}
                {% assign category_handle = 'play' %}
              {% else %}
                {% assign category_title = 'home.categories.misc' | t %}
            {% endcase %}
            {% if category_handle != blank %}
              {% assign category_collection = collections[category_handle] %}
              {% if category_collection != blank %}
                {% assign category_title = category_collection.title | capitalize %}
              {% endif %}
            {% endif %}
          {% endif %}

          {% assign category_url = block.settings.link_url %}
          {% if category_url == blank %}
            {% if block.settings.collection != blank %}
              {% assign category_url = block.settings.collection.url %}
            {% elsif category_handle != blank %}
              {% assign category_collection = collections[category_handle] %}
              {% if category_collection != blank %}
                {% assign category_url = category_collection.url %}
              {% else %}
                {% assign category_url = blank %}
              {% endif %}
            {% else %}
              {% assign category_url = routes.all_products_collection_url %}
            {% endif %}
          {% endif %}

          {% if category_url != blank %}
          <a class="category-card" href="{{ category_url }}" {{ block.shopify_attributes }}>
            <div class="category-card__media category-card__media--{{ forloop.index }}">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: class: 'category-card__image', alt: block.settings.image.alt | default: category_title }}
              {% else %}
                <div class="category-card__placeholder">
                  {% render 'category-illustration', index: forloop.index %}
                </div>
              {% endif %}
            </div>

            <div class="category-card__body">
              <span class="category-card__symbol" aria-hidden="true">
                {% case forloop.index %}
                  {% when 1 %}
                    <svg viewBox="0 0 24 24" fill="none"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.6"/><path d="M5 20a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="8" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 8V5h8v3M3 12h18M10 12v2h4v-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="m10 8 6 4-6 4V8Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round"/></svg>
                {% endcase %}
              </span>
              <h3>{{ category_title }}</h3>
              <span class="category-card__explore">{{ 'home.categories.explore' | t }}</span>
            </div>
          </a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% assign fallback_handles = 'home|personal|office|play' | split: '|' %}
        {% for fallback_handle in fallback_handles %}
          {% assign fallback_collection = collections[fallback_handle] %}
          {% if fallback_collection != blank %}
            <a class="category-card" href="{{ fallback_collection.url }}">
              <div class="category-card__media category-card__media--{{ forloop.index }}">
                <div class="category-card__placeholder">
                  {% render 'category-illustration', index: forloop.index %}
                </div>
              </div>
              <div class="category-card__body">
                <span class="category-card__symbol" aria-hidden="true">
                  {% case forloop.index %}
                    {% when 1 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    {% when 2 %}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.6"/><path d="M5 20a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    {% when 3 %}
                      <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="8" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 8V5h8v3M3 12h18M10 12v2h4v-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="m10 8 6 4-6 4V8Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round"/></svg>
                  {% endcase %}
                </span>
                <h3>{{ fallback_collection.title | capitalize }}</h3>
                <span class="category-card__explore">{{ 'home.categories.explore' | t }}</span>
              </div>
          </a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .home-categories {
    padding: clamp(3.5rem, 6vw, 6rem) 0;
    background: var(--brand-charcoal);
    color: var(--brand-white);
  }

  .home-categories__heading {
    max-width: 62rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-categories__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-pale-blue);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .home-categories__heading h2 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    letter-spacing: -0.085em;
    line-height: 0.9;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid rgba(255, 253, 248, 0.35);
  }

  .category-card {
    display: grid;
    grid-template-rows: minmax(11rem, 1fr) auto;
    min-height: 19rem;
    border: 0;
    border-radius: 0;
    overflow: hidden;
    background: var(--brand-white);
    color: var(--brand-charcoal);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .category-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.75rem 1.5rem rgba(17, 17, 17, 0.12);
  }

  .category-card:focus-visible {
    outline: 3px solid var(--brand-cobalt);
    outline-offset: 3px;
  }

  .category-card__media {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 11rem;
    overflow: hidden;
    background: var(--brand-pale-blue);
  }

  .category-card__media--1 {
    background: #E4EAF9;
  }

  .category-card__media--2 {
    background: #F8E6DD;
  }

  .category-card__media--3 {
    background: #E4EEE7;
  }

  .category-card__media--4 {
    background: #F5E9C9;
  }

  .category-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .category-card__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .category-card__illustration {
    display: block;
    width: min(76%, 13rem);
    height: auto;
    overflow: visible;
    transition: transform 0.35s ease;
  }

  .category-card:hover .category-card__image,
  .category-card:hover .category-card__illustration {
    transform: scale(1.05);
  }

  .category-card__body {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: 0.4rem 0.65rem;
    min-height: 5rem;
    padding: 0.9rem 1rem;
    background: var(--brand-white);
    color: var(--brand-charcoal);
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .category-card:hover .category-card__body,
  .category-card:focus-visible .category-card__body {
    background: var(--brand-cobalt);
    color: var(--brand-white);
  }

  .category-card__symbol {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--brand-cobalt);
    background: var(--brand-pale-blue);
    border: 0;
    transition: color 0.25s ease, background-color 0.25s ease;
  }

  .category-card:hover .category-card__symbol,
  .category-card:focus-visible .category-card__symbol {
    color: var(--brand-cobalt);
    background: var(--brand-white);
  }

  .category-card__symbol svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .category-card__body h3 {
    min-width: 0;
    font-size: clamp(1.15rem, 1.6vw, 1.65rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .category-card__explore {
    display: inline-flex;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-muted);
    transition: color 0.25s ease;
  }

  .category-card:hover .category-card__explore,
  .category-card:focus-visible .category-card__explore {
    color: var(--brand-white);
  }

  @media (max-width: 980px) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .category-card {
      min-height: 16rem;
    }

    .category-card__media {
      min-height: 9rem;
    }

    .category-card__body {
      gap: 0.4rem;
      padding: 0.8rem;
    }

    .category-card__symbol {
      width: 2rem;
      height: 2rem;
    }

    .category-card__symbol svg {
      width: 1rem;
      height: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .category-card__image,
    .category-card__illustration,
    .category-card__body,
    .category-card__symbol,
    .category-card__explore {
      transition: none;
    }

    .category-card:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category discovery",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Custom destination URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category discovery",
      "category": "Homepage",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
