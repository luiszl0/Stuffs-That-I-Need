{%- assign showcase_images = product.images | slice: 2, section.settings.max_images -%}
{%- if showcase_images.size > 0 -%}
  {%- assign heading = section.settings.heading -%}
  {%- if heading == blank -%}
    {%- assign heading = 'product_page.showcase.heading' | t -%}
  {%- endif -%}
  {%- assign heading_eyebrow = 'product_page.showcase.eyebrow' | t -%}
  <section
    class="pp-section pp-showcase"
    data-showcase
    data-label-more="{{ 'product_page.showcase.see_more' | t | escape }}"
    data-label-less="{{ 'product_page.showcase.see_less' | t | escape }}"
  >
    <div class="page-width">
      {% render 'product-section-heading', eyebrow: heading_eyebrow, heading: heading, text: section.settings.text %}
      <div class="pp-showcase__grid" id="showcase-grid-{{ section.id }}">
        {% for image in showcase_images %}
          <figure class="pp-showcase__item" {% if forloop.index > section.settings.initial_images %}data-showcase-extra hidden{% endif %}>
            {{ image | image_url: width: 900 | image_tag:
              alt: image.alt | default: product.title,
              widths: '360, 540, 720, 900',
              sizes: '(min-width: 821px) 33vw, (min-width: 481px) 50vw, 100vw',
              loading: 'lazy'
            }}
            {% if image.alt != blank and image.alt != product.title %}
              <figcaption>{{ image.alt }}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      </div>

      {% if showcase_images.size > section.settings.initial_images %}
        <div class="pp-showcase__more">
          <button
            type="button"
            class="button button--secondary"
            data-showcase-toggle
            aria-expanded="false"
            aria-controls="showcase-grid-{{ section.id }}"
          >
            {{ 'product_page.showcase.see_more' | t }}
          </button>
        </div>
      {% endif %}
    </div>
  </section>
{%- endif -%}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-showcase]').forEach(function (root) {
      var toggle = root.querySelector('[data-showcase-toggle]');
      if (!toggle) return;
      var extras = root.querySelectorAll('[data-showcase-extra]');

      toggle.addEventListener('click', function () {
        var expanding = toggle.getAttribute('aria-expanded') !== 'true';
        extras.forEach(function (item) { item.hidden = !expanding; });
        toggle.setAttribute('aria-expanded', expanding ? 'true' : 'false');
        toggle.textContent = expanding ? root.dataset.labelLess : root.dataset.labelMore;
        if (!expanding) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  });
{% endjavascript %}

{% stylesheet %}
  .pp-showcase .pp-heading h2 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }
  .pp-showcase__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  .pp-showcase__item {
    position: relative;
    margin: 0;
    background: var(--brand-pale-blue);
    overflow: hidden;
  }
  .pp-showcase__item[hidden] {
    display: none;
  }
  .pp-showcase__item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .pp-showcase__item figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: min(100%, 28rem);
    padding: 0.7rem 1rem;
    background: var(--brand-white);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .pp-showcase__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (max-width: 820px) {
    .pp-showcase__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .pp-showcase__grid {
      grid-template-columns: 1fr;
    }
    .pp-showcase__more .button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_page.showcase.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "range",
      "id": "initial_images",
      "label": "t:product_page.showcase.initial_images",
      "min": 3,
      "max": 9,
      "step": 3,
      "default": 3
    },
    {
      "type": "range",
      "id": "max_images",
      "label": "t:product_page.showcase.max_images",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "t:product_page.showcase.name" }]
}
{% endschema %}
