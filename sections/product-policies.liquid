{%- assign has_shipping = false -%}
{%- if shop.shipping_policy or section.settings.shipping_text != blank -%}
  {%- assign has_shipping = true -%}
{%- endif -%}
{%- assign has_returns = false -%}
{%- if shop.refund_policy or section.settings.returns_text != blank -%}
  {%- assign has_returns = true -%}
{%- endif -%}
{%- assign has_payments = false -%}
{%- if shop.enabled_payment_types.size > 0 -%}
  {%- assign has_payments = true -%}
{%- endif -%}

{%- if has_shipping or has_returns or has_payments -%}
  {%- assign heading = section.settings.heading -%}
  {%- if heading == blank -%}
    {%- assign heading = 'product_page.policies.heading' | t -%}
  {%- endif -%}
  <section class="pp-section pp-policies">
    <div class="page-width">
      {%- assign heading_eyebrow = 'product_page.policies.eyebrow' | t -%}
      {% render 'product-section-heading', eyebrow: heading_eyebrow, heading: heading %}
      <div class="pp-policies__grid">
        {% if has_shipping %}
          <article class="pp-policies__card">
            <span class="pp-policies__icon">{% render 'icon', name: 'truck' %}</span>
            <h3>{{ 'products.shipping' | t }}</h3>
            {% if section.settings.shipping_text != blank %}
              <p>{{ section.settings.shipping_text }}</p>
            {% elsif shop.shipping_policy %}
              <p>{{ shop.shipping_policy.body | strip_html | strip | truncatewords: 40 }}</p>
            {% endif %}
            {% if shop.shipping_policy %}
              <a href="{{ shop.shipping_policy.url }}">{{ 'policies.shipping' | t }}</a>
            {% endif %}
          </article>
        {% endif %}

        {% if has_returns %}
          <article class="pp-policies__card">
            <span class="pp-policies__icon">{% render 'icon', name: 'return' %}</span>
            <h3>{{ 'products.returns' | t }}</h3>
            {% if section.settings.returns_text != blank %}
              <p>{{ section.settings.returns_text }}</p>
            {% elsif shop.refund_policy %}
              <p>{{ shop.refund_policy.body | strip_html | strip | truncatewords: 40 }}</p>
            {% endif %}
            {% if shop.refund_policy %}
              <a href="{{ shop.refund_policy.url }}">{{ 'policies.returns' | t }}</a>
            {% endif %}
          </article>
        {% endif %}

        {% if has_payments %}
          <article class="pp-policies__card">
            <span class="pp-policies__icon">{% render 'icon', name: 'lock' %}</span>
            <h3>{{ 'product_page.payment.title' | t }}</h3>
            <p>{{ 'product_page.payment.secure_text' | t }}</p>
            <ul class="pp-policies__payments" aria-label="{{ 'product_page.payment.methods' | t }}">
              {% for type in shop.enabled_payment_types %}
                <li>{{ type | payment_type_svg_tag: class: 'pp-policies__payment-icon' }}</li>
              {% endfor %}
            </ul>
          </article>
        {% endif %}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .pp-policies__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1px;
    background: var(--brand-border);
    border: 1px solid var(--brand-border);
  }
  .pp-policies__card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.8rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--brand-white);
  }
  .pp-policies__card h3 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
  }
  .pp-policies__card p {
    margin: 0;
    color: var(--brand-muted);
    line-height: 1.65;
  }
  .pp-policies__card a {
    color: var(--brand-cobalt);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pp-policies__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    background: var(--brand-pale-blue);
    color: var(--brand-cobalt);
  }
  .pp-policies__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pp-policies__payment-icon {
    display: block;
    width: 2.4rem;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_page.policies.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "t:product_page.settings.shipping_note",
      "info": "t:product_page.settings.verified_info"
    },
    {
      "type": "textarea",
      "id": "returns_text",
      "label": "t:product_page.settings.returns_note",
      "info": "t:product_page.settings.verified_info"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "t:product_page.policies.name" }]
}
{% endschema %}
